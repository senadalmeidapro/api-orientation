<!DOCTYPE html>
<html lang='{{#if lang}}{{lang}}{{else}}fr{{/if}}'>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1.0' />
        <meta http-equiv='X-UA-Compatible' content='ie=edge' />
        <title>{{#if title}}{{title}}{{else}}Reinitialisation du mot de passe {{appName}}{{/if}}</title>
        <style>
            body,
            table,
            td,
            a {
                -webkit-text-size-adjust: 100%;
                -ms-text-size-adjust: 100%;
            }
            table,
            td {
                mso-table-lspace: 0pt;
                mso-table-rspace: 0pt;
            }
            table {
                border-collapse: collapse !important;
            }
            img {
                border: 0;
                outline: none;
                text-decoration: none;
                -ms-interpolation-mode: bicubic;
            }
            @media only screen and (max-width: 640px) {
                .email-shell {
                    width: 100% !important;
                }
                .mobile-padding {
                    padding-left: 20px !important;
                    padding-right: 20px !important;
                }
                .button-block {
                    display: block !important;
                    width: 100% !important;
                    box-sizing: border-box;
                }
            }
        </style>
    </head>
    <body style='margin: 0; padding: 0; background-color: #f7f9fc;'>
        <div style='display: none; max-height: 0; overflow: hidden; opacity: 0;'>
            Reinitialisez votre mot de passe {{appName}} avec ce lien securise.
        </div>

        <table
            role='presentation'
            width='100%'
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='background-color: #f7f9fc;'
        >
            <tr>
                <td align='center' style='padding: 24px 12px;'>
                    <table
                        role='presentation'
                        width='100%'
                        cellpadding='0'
                        cellspacing='0'
                        border='0'
                        class='email-shell'
                        style='max-width: 640px; border: 1px solid #e2e8f0; background-color: #ffffff; border-radius: 18px; overflow: hidden;'
                    >
                        <tr>
                            <td
                                class='mobile-padding'
                                style='padding: 32px 36px; text-align: center; color: #ffffff; background-color: #00478d; background-image: linear-gradient(135deg, #00478d 0%, #005eb8 100%);'
                            >
                                <p style='margin: 0; font-family: Arial, Helvetica, sans-serif; font-size: 14px; letter-spacing: 0.4px; color: #dbeafe;'>{{appName}}</p>
                                <h1 style='margin: 12px 0 0; font-family: Arial, Helvetica, sans-serif; font-size: 30px; line-height: 1.2; font-weight: 700; color: #ffffff;'>Reinitialisation du mot de passe</h1>
                                <p style='margin: 10px 0 0; font-family: Arial, Helvetica, sans-serif; font-size: 15px; line-height: 1.6; color: #d9e7ff;'>Un lien securise a ete genere pour votre compte.</p>
                            </td>
                        </tr>

                        <tr>
                            <td
                                class='mobile-padding'
                                style='padding: 34px 36px 24px; font-family: Arial, Helvetica, sans-serif; color: #1f2937; font-size: 16px; line-height: 1.65;'
                            >
                                {{#if fullName}}
                                    <p style='margin: 0 0 16px;'>Bonjour <strong>{{fullName}}</strong>,</p>
                                {{else}}
                                    <p style='margin: 0 0 16px;'>Bonjour,</p>
                                {{/if}}

                                <p style='margin: 0 0 20px;'>Nous avons recu une demande de reinitialisation du mot de passe pour votre compte {{#if appName}}{{appName}}{{/if}}. Si vous etes a l'origine de cette demande, cliquez sur le bouton ci-dessous :</p>

                                <table role='presentation' cellpadding='0' cellspacing='0' border='0' align='center' style='margin: 10px auto 26px;'>
                                    <tr>
                                        <td align='center' style='border-radius: 999px; background-color: #00478d;'>
                                            <a
                                                href='{{resetLink}}'
                                                class='button-block'
                                                style='display: inline-block; padding: 14px 30px; border-radius: 999px; font-family: Arial, Helvetica, sans-serif; font-size: 15px; font-weight: 700; line-height: 1.2; text-decoration: none; color: #ffffff; background-color: #00478d; background-image: linear-gradient(135deg, #00478d 0%, #005eb8 100%);'
                                            >Reinitialiser mon mot de passe</a>
                                        </td>
                                    </tr>
                                </table>

                                <table
                                    role='presentation'
                                    width='100%'
                                    cellpadding='0'
                                    cellspacing='0'
                                    border='0'
                                    style='margin: 0 0 22px; background-color: #f8fafc; border: 1px solid #dbe2ea; border-radius: 10px;'
                                >
                                    <tr>
                                        <td style='padding: 14px 16px; font-family: Arial, Helvetica, sans-serif;'>
                                            <p style='margin: 0; font-size: 14px; color: #334155;'>Ce lien expirera dans <strong style='color: #0f172a;'>{{expiresIn}}</strong>.</p>
                                        </td>
                                    </tr>
                                </table>

                                <p style='margin: 0 0 10px;'>Si le bouton ne fonctionne pas, copiez et collez ce lien dans votre navigateur :</p>
                                <p style='margin: 0 0 22px; word-break: break-all; font-size: 13px; line-height: 1.6;'>
                                    <a href='{{resetLink}}' style='color: #005eb8; text-decoration: underline;'>{{resetLink}}</a>
                                </p>

                                <table
                                    role='presentation'
                                    width='100%'
                                    cellpadding='0'
                                    cellspacing='0'
                                    border='0'
                                    style='margin: 0 0 22px; background-color: #fff7ed; border: 1px solid #fed7aa; border-radius: 10px;'
                                >
                                    <tr>
                                        <td style='padding: 14px 16px; font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #7c2d12; line-height: 1.55;'>
                                            <strong>Vous n'etes pas a l'origine de cette demande ?</strong><br />
                                            Ignorez simplement cet email. Votre compte reste securise.
                                        </td>
                                    </tr>
                                </table>

                                <p style='margin: 0; font-size: 14px; color: #475569;'>Pour votre securite, ne partagez jamais ce lien avec qui que ce soit.</p>
                            </td>
                        </tr>

                        <tr>
                            <td
                                class='mobile-padding'
                                style='padding: 22px 36px 28px; text-align: center; background-color: #f2f4f7; border-top: 1px solid #e2e8f0; font-family: Arial, Helvetica, sans-serif;'
                            >
                                <p style='margin: 0; font-size: 13px; line-height: 1.6; color: #64748b;'>&copy; {{currentYear}} {{appName}}. Tous droits reserves.</p>
                                <p style='margin: 10px 0 0; font-size: 13px; line-height: 1.6; color: #64748b;'>
                                    {{#if privacyPolicyUrl}}
                                        <a href='{{privacyPolicyUrl}}' style='color: #005eb8; text-decoration: none;'>Politique de confidentialite</a>
                                    {{/if}}
                                    {{#if contactUrl}}
                                        {{#if privacyPolicyUrl}} <span style='color: #94a3b8;'>&bull;</span> {{/if}}
                                        <a href='{{contactUrl}}' style='color: #005eb8; text-decoration: none;'>Contact</a>
                                    {{/if}}
                                </p>
                                {{#if supportEmail}}
                                    <p style='margin: 10px 0 0; font-size: 12px; line-height: 1.6; color: #64748b;'>
                                        Besoin d'aide ? Ecrivez-nous a
                                        <a href='mailto:{{supportEmail}}' style='color: #005eb8; text-decoration: none;'>{{supportEmail}}</a>.
                                    </p>
                                {{/if}}
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
