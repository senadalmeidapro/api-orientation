{
    "compilerOptions": {
        "module": "commonjs", // ← fix
        "moduleResolution": "node", // ← fix
        "target": "ES2023",
        "noEmitOnError": false, // ← safer for dev watch mode
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "declaration": true,
        "sourceMap": true,
        "incremental": true,
        "tsBuildInfoFile": "./dist/.tsbuildinfo", // ← keeps root clean
        "strict": true,
        "strictNullChecks": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitAny": false,
        "noFallthroughCasesInSwitch": true,
        "isolatedModules": true,
        "removeComments": true,
        "skipLibCheck": true,
        "rootDir": "./src",
        "outDir": "./dist",
        "types": ["node"],
        "typeRoots": ["./node_modules/@types", "./src/common/types"]
    },
    "include": ["src/**/*", "prisma/**/*"],
    "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
