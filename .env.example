# Local environment configuration (do not commit secrets)

# ------------------------------------------------------------------------------
# Core
# ------------------------------------------------------------------------------
NODE_ENV=development
NODE_VERSION=20
NPM_VERSION=10

APP_ENV=development
APP_NAME=Orientation API
APP_DESCRIPTION="Documentation technique de l'API d'orientation"
APP_VERSION=1.0.0
APP_URL=http://localhost:3000
BACK_URL=http://localhost:3000
SUPPORT_EMAIL=support@example.com
APP_LOCAL=fr
APP_FAKER_LOCAL=fr
APP_FALLBACK_LOCAL=fr
APP_DEBUG=false

# Railway injects PORT automatically. APP_PORT/APP_HOST are app-specific aliases.
PORT=3000
HOST=0.0.0.0
APP_PORT=3000
APP_HOST=0.0.0.0

LOG_LEVEL=info
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# Security / Throttling / Admin
# ------------------------------------------------------------------------------
SECURE_SESSION_KEY=change_me_session_key
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
CSRF_ENABLED=false

ADMIN_EMAIL=admin@example.com
ADMIN_KEY=change_me_admin_key

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,Origin,X-Requested-With,X-Device-Id,X-Metrics-Token
CORS_EXPOSED_HEADERS=Content-Disposition
CORS_MAX_AGE=600

# ------------------------------------------------------------------------------
# Swagger
# ------------------------------------------------------------------------------
SWAGGER_PATH=api/v1/docs
SWAGGER_SERVER_URLS=http://localhost:3000
SWAGGER_CONTACT_NAME=API Team
SWAGGER_CONTACT_URL=https://example.com
SWAGGER_CONTACT_EMAIL=support@example.com

# ------------------------------------------------------------------------------
# Database (required)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_NAME=orientation
POSTGRES_SSL=false
POSTGRES_CONNECTION_TIMEOUT=5000
POSTGRES_IDLE_TIMEOUT=10000

# ------------------------------------------------------------------------------
# JWT Auth (required)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=change_me
JWT_ACCESS_EXPIRES_IN=900
JWT_SALT_ROUNDS=10
JWT_REFRESH_SECRET=change_me_refresh
JWT_REFRESH_EXPIRES_IN=604800
JWT_ISSUER=api-orientation
JWT_AUDIENCE=api-orientation

# ------------------------------------------------------------------------------
# OAuth
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# SMTP Email (required by current config service)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_SECURE=false
EMAIL_USER=smtp-user
EMAIL_PASSWORD=smtp-password
EMAIL_FROM=no-reply@example.com
EMAIL_CONNECTION_TIMEOUT=10000
EMAIL_GREETING_TIMEOUT=10000
EMAIL_SOCKET_TIMEOUT=10000
EMAIL_TEMPLATE_PATH=templates/email
EMAIL_DEFAULT_LANGUAGE=fr
EMAIL_LOGGING=false

# ------------------------------------------------------------------------------
# Storage / Upload
# ------------------------------------------------------------------------------
UPLOAD_DIR=storage
MAX_FILE_SIZE_MB=20

# Cloudinary (required by current config service)
CLOUDINARY_URL=cloudinary://key:secret@cloud_name
CLOUDINARY_CLOUD_NAME=cloud_name
CLOUDINARY_API_KEY=cloudinary_key
CLOUDINARY_API_SECRET=cloudinary_secret
CLOUDINARY_SECURE=true
CLOUDINARY_VALIDATE=false
CLOUDINARY_OPTIMIZE=false
CLOUDINARY_TRANSFORMATIONS=false

# S3 (optional for runtime features)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ------------------------------------------------------------------------------
# Cache / Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0
REDIS_TTL=3600

# ------------------------------------------------------------------------------
# Payments (required by current config service)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=stripe_secret_key
STRIPE_PUBLIC_KEY=stripe_public_key
STRIPE_WEBHOOK_SECRET=stripe_webhook_secret
STRIPE_API_VERSION=2024-06-20

FEDAPAY_API_KEY=fedapay_api_key
FEDAPAY_PUBLIC_KEY=fedapay_public_key
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_WEBHOOK_TOKEN=fedapay_webhook_token
FEDAPAY_MERCHANT_NAME=Merchant Name
FEDAPAY_MERCHANT_EMAIL=merchant@example.com
FEDAPAY_MERCHANT_PHONE=+22900000000

PAYMENT_SUCCESS_URL=http://localhost:5173/payment/success
PAYMENT_CANCEL_URL=http://localhost:5173/payment/cancel
PAYMENT_WEBHOOK_URL=http://localhost:3000/api/v1/payments/webhook

# ------------------------------------------------------------------------------
# PDF
# ------------------------------------------------------------------------------
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
PDF_TEMP_DIR=/tmp
PDF_PAGE_SIZE=A4
PDF_MARGIN=10

# ------------------------------------------------------------------------------
# OpenAI (optional for runtime features)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TIMEOUT_MS=15000
OPENAI_TEMPERATURE=0.3

# ------------------------------------------------------------------------------
# Brevo (optional module-level integration)
# ------------------------------------------------------------------------------
BREVO_API_KEY=your_brevo_api_key_here
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_TIMEOUT_MS=10000
BREVO_RETRY_MAX_ATTEMPTS=3
BREVO_RETRY_BASE_DELAY_MS=200
BREVO_RETRY_MAX_DELAY_MS=2000
DEFAULT_FROM_EMAIL=noreply@example.com
DEFAULT_FROM_NAME=Your App Name
BREVO_TEMPLATE_EMAIL_VERIFICATION_ID=
BREVO_TEMPLATE_PASSWORD_RESET_ID=
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Docker / Compose overrides (optional)
# ------------------------------------------------------------------------------
API_PORT=3000
DATABASE_URL_DOCKER=postgresql://postgres:postgres@db:5432/orientation
REDIS_URL_DOCKER=redis://redis:6379
DOCKER_POSTGRES_DB=orientation
DOCKER_POSTGRES_USER=postgres
DOCKER_POSTGRES_PASSWORD=postgres
# API_IMAGE=ghcr.io/owner/api-orientation
