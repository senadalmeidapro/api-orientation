<html lang='{{lang}}'>

    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1.0' />
        <meta http-equiv='X-UA-Compatible' content='ie=edge' />
        <title>{{title}}</title>
        <style>
            /* Styles de base supportés par la plupart des clients email */
            .email-container {
                max-width: 600px;
                margin: 0 auto;
                font-family: Arial, Helvetica, sans-serif;
                background-color: #ffffff;
                border: 1px solid #eaeaea;
                border-radius: 8px;
                overflow: hidden;
            }

            .header {
                background-color: #4a6fa5;
                padding: 30px 20px;
                text-align: center;
                color: white;
            }

            .content {
                padding: 30px 20px;
                color: #333333;
                line-height: 1.6;
            }

            .button {
                display: inline-block;
                background-color: #4a6fa5;
                color: #ffffff !important;
                text-decoration: none;
                padding: 14px 30px;
                border-radius: 6px;
                font-weight: bold;
                margin: 20px 0;
                border: 1px solid #3a5a8c;
            }

            .footer {
                background-color: #f8f9fa;
                padding: 20px;
                text-align: center;
                font-size: 13px;
                color: #6c757d;
                border-top: 1px solid #dee2e6;
            }

            .link {
                color: #4a6fa5;
                word-break: break-all;
            }

            @media only screen and (max-width: 480px) {
                .email-container {
                    width: 100% !important;
                }

                .button {
                    display: block;
                    text-align: center;
                }
            }
        </style>
    </head>

    <body
        style='margin: 0; padding: 20px; background-color: #f4f6f9; font-family: Arial, Helvetica, sans-serif;'
    >
        <!-- Conteneur principal centré -->
        <table
            width='100%'
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='background-color: #f4f6f9;'
        >
            <tr>
                <td align='center' style='padding: 20px;'>
                    <div class='email-container'>
                        <!-- En-tête -->
                        <div class='header'>
                            <h1 style='margin: 0; font-size: 28px;'>{{appName}}</h1>
                        </div>

                        <!-- Contenu principal -->
                        <div class='content'>
                            <h2 style='margin-top: 0; color: #2c3e50;'>Vérification de votre adresse
                                email</h2>

                            {{#if fullName}}
                                <p>Bonjour <strong>{{fullName}}</strong>,</p>
                            {{else}}
                                <p>Bonjour,</p>
                            {{/if}}

                            <p>Merci de vous être inscrit{{#if appName}}
                                    chez
                                    {{appName}}{{/if}}. Pour finaliser la création de votre compte,
                                veuillez vérifier votre adresse email en cliquant sur le bouton
                                ci-dessous :</p>

                            <!-- Bouton d'action -->
                            <div style='text-align: center;'>
                                <a
                                    href='{{verificationLink}}'
                                    class='button'
                                    style='color: #ffffff;'
                                >Vérifier mon adresse email</a>
                            </div>

                            <p style='margin-top: 20px;'>Ce lien de vérification expirera dans
                                <strong>{{expirationTime}}</strong>.</p>

                            <p>Si le bouton ne fonctionne pas, copiez et collez le lien suivant dans
                                votre navigateur :</p>
                            <p style='word-break: break-all;'>
                                <a href='{{verificationLink}}' class='link'>{{verificationLink}}</a>
                            </p>

                            <hr
                                style='border: none; border-top: 1px solid #eaeaea; margin: 30px 0;'
                            />

                            <p style='font-size: 14px;'>Si vous n'avez pas demandé la création d'un
                                compte, vous pouvez ignorer cet email en toute sécurité.</p>
                        </div>

                        <!-- Pied de page -->
                        <div class='footer'>
                            <p style='margin: 5px 0;'>&copy;
                                {{currentYear}}
                                {{appName}}. Tous droits réservés.</p>
                            <p style='margin: 5px 0;'>
                                <a href='{{privacyPolicyUrl}}' style='color: #4a6fa5;'>Politique de
                                    confidentialité</a>
                                |
                                <a href='{{contactUrl}}' style='color: #4a6fa5;'>Contact</a>
                            </p>
                            {{#if supportEmail}}
                                <p style='margin: 15px 0 0;'>Besoin d'aide ? Contactez-nous à
                                    <a
                                        href='mailto:{{supportEmail}}'
                                        style='color: #4a6fa5;'
                                    >{{supportEmail}}</a></p>
                            {{/if}}
                        </div>
                    </div>
                </td>
            </tr>
        </table>

        <!-- Fallback pour les clients qui désactivent les images/styles -->
        <div style='display: none; max-height: 0; overflow: hidden;'>
            Pour vérifier votre adresse email, copiez ce lien :
            {{verificationLink}}
        </div>
    </body>

</html>