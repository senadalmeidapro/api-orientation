generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// TYPES DE BASE ET ÉNUMÉRATIONS
// =====================================================

enum RiasecType {
  R // Réaliste
  I // Investigateur
  A // Artistique
  S // Social
  E // Entreprenant
  C // Conventionnel
}

enum PhaseType {
  PHASE_1
  PHASE_2
  PHASE_3
}

enum SectionType {
  OCCUPATIONS
  APTITUDES
  PERSONALITY
}

enum BadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum ProfileStrength {
  TRES_FAIBLE
  FAIBLE
  MOYEN
  FORT
  TRES_FORT
  EXCEPTIONNEL
}

enum ConsistencyLevel {
  FAIBLE // 1
  MOYENNE // 2
  FORTE // 3
}

enum Label {
  Faible
  Moyen
  Fort
}

enum CareerCategory {
  NUMERIQUE
  AGRICULTURE
  ARTISANAT
  SANTE
  EDUCATION
  COMMERCE
  ADMINISTRATION
}

enum FeedbackType {
  LIKE
  DISLIKE
  CLICK
  VIEW
  SKIP
}

enum InteractionEventType {
  ANSWER
  CLICK
  VIEW
  SKIP
}

enum InteractionEntityType {
  QUESTION
  CAREER
  RECOMMENDATION
}

enum OutcomeStatus {
  STUDENT
  INTERNSHIP
  EMPLOYED
  DROPOUT
}

// =====================================================
// VERSIONING & LOCALISATION
// =====================================================

model TestVersion {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  description String? @db.Text
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phase1Questions Phase1Question[]
  phase2Questions Phase2Question[]
  sessions        TestSession[]

  @@index([isActive])
  @@map("test_versions")
}

model Language {
  id         Int     @id @default(autoincrement())
  code       String  @unique // fr, fon, yoruba, etc.
  name       String
  nativeName String?
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phase1QuestionTranslations Phase1QuestionTranslation[]
  phase2QuestionTranslations Phase2QuestionTranslation[]
  careerTranslations         CareerTranslation[]
  resourceTranslations       ResourceTranslation[]
  institutionTranslations    TrainingInstitutionTranslation[]

  @@index([isActive])
  @@map("languages")
}

// =====================================================
// SESSIONS DE TEST
// =====================================================

// Session de test (anonyme, isolée)
model TestSession {
  id            String      @id @default(uuid())
  testVersionId Int
  testVersion   TestVersion @relation(fields: [testVersionId], references: [id], onDelete: Restrict)

  // Identifiants
  sessionToken String  @unique
  shareToken   String? @unique // Pour partage public

  // Progression
  currentPhase     PhaseType    @default(PHASE_1)
  currentStepIndex Int          @default(0)
  currentSection   SectionType? // Pour phase 2

  // Timestamps
  startedAt         DateTime  @default(now())
  lastActivityAt    DateTime  @updatedAt
  completedAt       DateTime?
  phase1CompletedAt DateTime?
  phase2CompletedAt DateTime?
  phase3CompletedAt DateTime?

  // État
  isAbandoned          Boolean @default(false)
  completionPercentage Int     @default(0)

  // Relations
  phase1Responses Phase1Response[]
  phase2Responses Phase2Response[]
  result          SessionResult?
  treasureMap     TreasureMap?
  feedbacks       SessionFeedback[]
  sessionBadges   SessionBadge[]
  xpEvents        SessionXP[]
  sessionLevel    SessionLevel?
  outcomes        SessionOutcome[]
  interactions    SessionInteraction[]

  @@index([testVersionId])
  @@index([sessionToken])
  @@index([shareToken])
  @@index([startedAt])
  @@index([isAbandoned])
  @@index([completionPercentage])
  @@map("test_sessions")
}

// =====================================================
// QUESTIONS ET RÉPONSES
// =====================================================

// Types RIASEC (R, I, A, S, E, C)
model RiasecTypeModel {
  id           RiasecType @id // 'R', 'I', 'A', 'S', 'E', 'C'
  name         String // 'Réaliste', 'Investigateur', etc.
  slogan       String?
  description  String? // Description longue
  colorHex     String? // Code couleur pour UI
  iconUrl      String? // URL de l'icône
  displayOrder Int        @default(0)

  // Relations
  phase1Questions Phase1Question[]
  phase2Questions Phase2Question[]

  @@map("riasec_types")
}

// Questions de la Phase 1 (Amorce)
model Phase1Question {
  id            Int             @id @default(autoincrement())
  riasecTypeId  RiasecType
  riasecType    RiasecTypeModel @relation(fields: [riasecTypeId], references: [id])
  testVersionId Int
  testVersion   TestVersion     @relation(fields: [testVersionId], references: [id], onDelete: Cascade)

  questionText    String  @db.Text
  questionShort   String? // Version courte pour mobile
  illustrationUrl String? // Image ou icône associée
  displayOrder    Int     @default(0)
  isActive        Boolean @default(true)

  // Gamification
  pointsValue Int @default(10) // Points gagnés en répondant

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  responses    Phase1Response[]
  translations Phase1QuestionTranslation[]

  @@unique([testVersionId, displayOrder])
  @@index([riasecTypeId])
  @@index([testVersionId])
  @@index([displayOrder])
  @@index([isActive])
  @@map("phase1_questions")
}

// Questions de la Phase 2 (Approfondissement)
model Phase2Question {
  id            Int             @id @default(autoincrement())
  riasecTypeId  RiasecType
  riasecType    RiasecTypeModel @relation(fields: [riasecTypeId], references: [id])
  testVersionId Int
  testVersion   TestVersion     @relation(fields: [testVersionId], references: [id], onDelete: Cascade)

  sectionType     SectionType // 'OCCUPATIONS', 'APTITUDES', 'PERSONALITY'
  questionText    String      @db.Text
  questionSubtext String? // Sous-titre ou indication
  mediaUrl        String? // Image ou vidéo courte
  displayOrder    Int         @default(0)
  isActive        Boolean     @default(true)

  // Pour les aptitudes (échelle 1-3)
  minValue    Int?  @default(1)
  maxValue    Int?  @default(3)
  valueLabels Json? // { "1": "Faible 😕", "2": "Moyen 😐", "3": "Fort 😊" }

  // Gamification
  pointsValue Int @default(15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  responses    Phase2Response[]
  translations Phase2QuestionTranslation[]

  @@unique([testVersionId, sectionType, displayOrder])
  @@index([riasecTypeId])
  @@index([testVersionId])
  @@index([sectionType])
  @@index([isActive])
  @@map("phase2_questions")
}

// Traductions des questions Phase 1
model Phase1QuestionTranslation {
  id         Int            @id @default(autoincrement())
  questionId Int
  question   Phase1Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  languageId Int
  language   Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)

  questionText  String  @db.Text
  questionShort String?
  audioUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([questionId, languageId])
  @@index([languageId])
  @@map("phase1_question_translations")
}

// Traductions des questions Phase 2
model Phase2QuestionTranslation {
  id         Int            @id @default(autoincrement())
  questionId Int
  question   Phase2Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  languageId Int
  language   Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)

  questionText    String  @db.Text
  questionSubtext String?
  audioUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([questionId, languageId])
  @@index([languageId])
  @@map("phase2_question_translations")
}

// Options de réponse pour les échelles d'aptitude
model AptitudeResponseOption {
  id        Int     @id @default(autoincrement())
  value     Int     @unique // 1, 2, 3
  label     Label // 'Faible', 'Moyen', 'Fort'
  emoji     String? // '😕', '😐', '😊'
  colorCode String? // '#FF4444', '#FFA500', '#4CAF50'

  @@map("aptitude_response_options")
}

// Réponses de la Phase 1
model Phase1Response {
  id         Int            @id @default(autoincrement())
  sessionId  String
  session    TestSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId Int
  question   Phase1Question @relation(fields: [questionId], references: [id])

  responseValue  Int // 0 pour non, 1 pour oui
  responseTimeMs Int? // Temps de réponse (ms)

  createdAt DateTime @default(now())

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
  @@index([createdAt])
  @@map("phase1_responses")
}

// Réponses de la Phase 2
model Phase2Response {
  id         Int            @id @default(autoincrement())
  sessionId  String
  session    TestSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId Int
  question   Phase2Question @relation(fields: [questionId], references: [id])

  responseValue  Int // Pour occupations: 0/1; aptitudes: 1-3; personality: 0/1
  responseTimeMs Int? // Temps de réponse

  createdAt DateTime @default(now())

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
  @@index([createdAt])
  @@map("phase2_responses")
}

// =====================================================
// RÉSULTATS ET CALCULS
// =====================================================

// Résultats calculés du test
model SessionResult {
  id        Int         @id @default(autoincrement())
  sessionId String      @unique
  session   TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Codes
  phase1Code        String @db.Char(3) // Ex: "RIA"
  phase2Code        String @db.Char(3) // Ex: "RIS"
  subjectiveRanking Json? // Classement subjectif des cartes EPCR

  // Scores bruts
  phase1Scores  Json // { "R": 5, "I": 3, "A": 8, "S": 2, "E": 1, "C": 0 }
  phase2Scores  Json // { "R": 15, "I": 22, "A": 18, "S": 10, "E": 5, "C": 8 }
  sectionScores Json // Scores détaillés par section

  // Indicateurs de qualité
  consistencyScore     Float // 1, 2, ou 3
  consistencyLevel     ConsistencyLevel
  differentiationScore Float // Calculé selon formule Vrignaud
  profileStrength      ProfileStrength

  // Interprétations
  insights  Json? // Liste d'insights personnalisés
  strengths String[] // Forces identifiées

  // Métadonnées
  createdAt    DateTime  @default(now())
  lastViewedAt DateTime?
  viewCount    Int       @default(0)

  // Relations
  careerRecommendations SessionCareerRecommendation[]

  @@index([sessionId])
  @@index([phase2Code])
  @@index([consistencyLevel])
  @@index([profileStrength])
  @@index([createdAt])
  @@map("session_results")
}

// =====================================================
// MÉTIERS ET RECOMMANDATIONS
// =====================================================

// Métiers (base de données locale)
model Career {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String  @db.Text
  summary     String? // Description courte (pour cartes)

  // Codes RIASEC associés (ex: ['R', 'I'])
  riasecCodes RiasecType[] // Stocké comme tableau PostgreSQL

  // Contexte béninois
  localDemand    Int? // 1-5 (demande au Bénin)
  formationLevel String? // 'CAP', 'BAC', 'BTS', 'Licence', 'EMN', etc.
  salaryRangeMin Int? // En FCFA
  salaryRangeMax Int? // En FCFA
  careerPath     String? // Évolution de carrière possible

  // Médias
  iconUrl  String?
  imageUrl String?
  videoUrl String?

  // Classification
  category CareerCategory? // 'NUMERIQUE', 'AGRICULTURE', 'ARTISANAT', 'SANTE', 'EDUCATION', 'COMMERCE', 'ADMINISTRATION'
  tags     String[] // Tags de recherche

  // Métadonnées
  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)
  viewCount  Int     @default(0)
  clickCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  recommendations SessionCareerRecommendation[]
  institutions    CareerInstitution[]
  resources       CareerResource[]
  translations    CareerTranslation[]
  outcomes        SessionOutcome[]

  @@index([category])
  @@index([isFeatured])
  @@index([localDemand])
  @@index([riasecCodes])
  @@map("careers")
}

// Relation métiers <-> établissements
model CareerInstitution {
  careerId      Int
  career        Career              @relation(fields: [careerId], references: [id], onDelete: Cascade)
  institutionId Int
  institution   TrainingInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  isPrimary     Boolean             @default(false)

  createdAt DateTime @default(now())

  @@id([careerId, institutionId])
  @@index([institutionId])
  @@map("career_institutions")
}

// Relation métiers <-> ressources
model CareerResource {
  careerId   Int
  career     Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  resourceId Int
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([careerId, resourceId])
  @@index([resourceId])
  @@map("career_resources")
}

// Traductions des métiers
model CareerTranslation {
  id         Int      @id @default(autoincrement())
  careerId   Int
  career     Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  languageId Int
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  name        String
  summary     String?
  description String  @db.Text
  audioUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([careerId, languageId])
  @@index([languageId])
  @@map("career_translations")
}

// Recommandations personnalisées pour un utilisateur
model SessionCareerRecommendation {
  id       Int           @id @default(autoincrement())
  resultId Int
  result   SessionResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  careerId Int
  career   Career        @relation(fields: [careerId], references: [id], onDelete: Cascade)

  matchScore   Int // Pourcentage de matching (0-100)
  rankPosition Int // Position dans le classement

  viewedAt      DateTime?
  savedForLater Boolean   @default(false)

  createdAt DateTime @default(now())

  feedbacks SessionFeedback[]

  @@unique([resultId, careerId])
  @@index([resultId])
  @@index([careerId])
  @@index([matchScore])
  @@index([rankPosition])
  @@map("session_career_recommendations")
}

// =====================================================
// GAMIFICATION (BADGES ET RÉCOMPENSES)
// =====================================================

// Définitions des badges
model Badge {
  id          Int     @id @default(autoincrement())
  code        String  @unique // 'EXPLORATEUR', 'BATISSEUR', etc.
  name        String
  description String  @db.Text
  iconUrl     String? // URL de l'icône
  emoji       String? // Fallback emoji

  rarity      BadgeRarity @default(COMMON)
  pointsValue Int         @default(50) // Points d'expérience

  // Condition de déblocage (JSON)
  unlockCondition Json? // { "type": "phase_completion", "phase": 1 }

  // Statistiques
  unlockCount Int @default(0) // Nombre de fois débloqué

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessionBadges SessionBadge[]

  @@index([rarity])
  @@index([unlockCount])
  @@map("badges")
}

// Badges débloqués par les utilisateurs
model SessionBadge {
  id        Int         @id @default(autoincrement())
  sessionId String
  session   TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  badgeId   Int
  badge     Badge       @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  unlockedAt     DateTime @default(now())
  sharedOnSocial Boolean  @default(false)

  @@unique([sessionId, badgeId])
  @@index([sessionId])
  @@index([badgeId])
  @@index([unlockedAt])
  @@map("session_badges")
}

// Historique des points d'expérience
model SessionXP {
  id        Int         @id @default(autoincrement())
  sessionId String
  session   TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  amount Int
  reason String?

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
  @@map("session_xp")
}

// Niveau actuel de la session
model SessionLevel {
  id        Int         @id @default(autoincrement())
  sessionId String      @unique
  session   TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  level     Int         @default(1)
  currentXp Int         @default(0)
  totalXp   Int         @default(0)

  updatedAt DateTime @updatedAt

  @@index([level])
  @@map("session_levels")
}

// =====================================================
// CARTE AU TRÉSOR (RÉSULTAT FINAL PERSONNALISÉ)
// =====================================================

// Carte au Trésor générée
model TreasureMap {
  id        Int         @id @default(autoincrement())
  sessionId String      @unique
  session   TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Données de la carte (JSON complet)
  mapData    Json // Stockage de tous les éléments visuels
  pdfUrl     String? // URL du PDF généré
  shareToken String  @unique // Pour partage public

  // Statistiques
  viewCount     Int @default(0)
  downloadCount Int @default(0)

  createdAt    DateTime  @default(now())
  lastViewedAt DateTime?

  @@index([shareToken])
  @@index([createdAt])
  @@map("treasure_maps")
}

// =====================================================
// FEEDBACK ET OUTCOMES
// =====================================================

model SessionFeedback {
  id Int @id @default(autoincrement())

  sessionId String
  session   TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  recommendationId Int?
  recommendation   SessionCareerRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  type  FeedbackType
  value Float

  context Json?

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([recommendationId])
  @@index([type])
  @@index([createdAt])
  @@map("session_feedbacks")
}

model SessionOutcome {
  id Int @id @default(autoincrement())

  sessionId String
  session   TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  careerId Int
  career   Career @relation(fields: [careerId], references: [id], onDelete: Cascade)

  status         OutcomeStatus
  sector         String
  salaryRange    String?
  delayToOutcome Int

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([careerId])
  @@index([status])
  @@index([createdAt])
  @@map("session_outcomes")
}

// =====================================================
// ADAPTIVE RECOMMENDATIONS
// =====================================================

model SessionInteraction {
  id         BigInt                @id @default(autoincrement())
  sessionId  String
  session    TestSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type       InteractionEventType
  entityType InteractionEntityType
  entityId   Int
  value      Float?
  metadata   Json?
  createdAt  DateTime              @default(now())

  @@index([sessionId])
  @@index([type])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("session_interactions")
}

// =====================================================
// CONTENU ÉDUCATIF ET RESSOURCES
// =====================================================

// Articles, vidéos, ressources sur les métiers
model Resource {
  id          Int    @id @default(autoincrement())
  title       String
  description String @db.Text
  content     String @db.Text // HTML ou Markdown
  contentType String // 'ARTICLE', 'VIDEO', 'PDF', 'LINK'

  // Médias
  thumbnailUrl String?
  mediaUrl     String? // URL de la vidéo/PDF

  // Classification
  category String? // 'METIER', 'FORMATION', 'ORIENTATION', 'CONSEIL'
  tags     String[]

  // Métadonnées
  author      String?
  viewCount   Int       @default(0)
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  relatedCareers CareerResource[]
  translations   ResourceTranslation[]

  @@index([category])
  @@index([isPublished])
  @@index([publishedAt])
  @@map("resources")
}

// Traductions des ressources
model ResourceTranslation {
  id         Int      @id @default(autoincrement())
  resourceId Int
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  languageId Int
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  title       String
  description String  @db.Text
  content     String  @db.Text
  audioUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resourceId, languageId])
  @@index([languageId])
  @@map("resource_translations")
}

// =====================================================
// FORMATIONS ET ÉTABLISSEMENTS
// =====================================================

// Établissements de formation au Bénin
model TrainingInstitution {
  id          Int     @id @default(autoincrement())
  name        String
  acronym     String? // EMN, ENEAM, IFRI, etc.
  description String? @db.Text

  type String? // 'UNIVERSITE', 'ECOLE', 'CENTRE', 'LYCEE_TECHNIQUE'

  // Localisation
  department String? // Département du Bénin
  city       String?
  address    String?

  // Contact
  phone   String?
  email   String?
  website String?

  // Offre de formation
  programs Json? // Liste des formations proposées

  // Métadonnées
  logoUrl  String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  careers      CareerInstitution[]
  translations TrainingInstitutionTranslation[]

  @@index([department])
  @@index([city])
  @@index([type])
  @@map("training_institutions")
}

// Traductions des établissements de formation
model TrainingInstitutionTranslation {
  id            Int                 @id @default(autoincrement())
  institutionId Int
  institution   TrainingInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  languageId    Int
  language      Language            @relation(fields: [languageId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, languageId])
  @@index([languageId])
  @@map("training_institution_translations")
}
