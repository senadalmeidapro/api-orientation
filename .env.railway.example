# Railway production environment variables
# Copy these keys into Railway service variables and replace placeholders.

NODE_ENV=production
NODE_VERSION=20
NPM_VERSION=10

APP_ENV=production
APP_NAME=Orientation API
APP_DESCRIPTION=Documentation technique de l API d orientation
APP_VERSION=1.0.0
APP_URL=https://your-api.up.railway.app
BACK_URL=https://your-api.up.railway.app
SUPPORT_EMAIL=support@your-domain.com
APP_LOCAL=fr
APP_FAKER_LOCAL=fr
APP_FALLBACK_LOCAL=fr
APP_DEBUG=false

# Railway injects PORT automatically.
HOST=0.0.0.0
APP_HOST=0.0.0.0
# APP_PORT intentionally omitted on Railway; injected PORT is used automatically.

LOG_LEVEL=info
TRUST_PROXY=true

SECURE_SESSION_KEY=replace-with-long-random-value
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
CSRF_ENABLED=false

ADMIN_EMAIL=admin@your-domain.com
ADMIN_KEY=replace-with-strong-admin-key

CORS_ORIGIN=https://your-frontend-domain.com
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,Origin,X-Requested-With,X-Device-Id,X-Metrics-Token
CORS_EXPOSED_HEADERS=Content-Disposition
CORS_MAX_AGE=600

SWAGGER_PATH=api/v1/docs
SWAGGER_SERVER_URLS=https://your-api.up.railway.app
SWAGGER_CONTACT_NAME=API Team
SWAGGER_CONTACT_URL=https://your-domain.com
SWAGGER_CONTACT_EMAIL=support@your-domain.com

# Use Railway PostgreSQL URL here
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB
POSTGRES_HOST=HOST
POSTGRES_PORT=5432
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_NAME=DB
POSTGRES_SSL=true
POSTGRES_CONNECTION_TIMEOUT=5000
POSTGRES_IDLE_TIMEOUT=10000

JWT_ACCESS_SECRET=replace-with-long-random-value
JWT_ACCESS_EXPIRES_IN=900
JWT_SALT_ROUNDS=10
JWT_REFRESH_SECRET=replace-with-long-random-value
JWT_REFRESH_EXPIRES_IN=604800
JWT_ISSUER=api-orientation
JWT_AUDIENCE=api-orientation

GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret
GOOGLE_CALLBACK_URL=https://your-api.up.railway.app/api/v1/auth/google/callback

EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_SECURE=false
EMAIL_USER=smtp-user
EMAIL_PASSWORD=smtp-password
EMAIL_FROM=no-reply@your-domain.com
EMAIL_CONNECTION_TIMEOUT=10000
EMAIL_GREETING_TIMEOUT=10000
EMAIL_SOCKET_TIMEOUT=10000
EMAIL_TEMPLATE_PATH=templates/email
EMAIL_DEFAULT_LANGUAGE=fr
EMAIL_LOGGING=false

UPLOAD_DIR=storage
MAX_FILE_SIZE_MB=20

CLOUDINARY_URL=cloudinary://key:secret@cloud_name
CLOUDINARY_CLOUD_NAME=cloud_name
CLOUDINARY_API_KEY=cloudinary_key
CLOUDINARY_API_SECRET=cloudinary_secret
CLOUDINARY_SECURE=true
CLOUDINARY_VALIDATE=false
CLOUDINARY_OPTIMIZE=false
CLOUDINARY_TRANSFORMATIONS=false

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# If Redis plugin is added on Railway, set Redis URL and matching host/port/password values.
REDIS_URL=redis://default:password@HOST:PORT
REDIS_HOST=HOST
REDIS_PORT=6379
REDIS_PASSWORD=password
REDIS_DB=0
REDIS_TTL=3600

STRIPE_SECRET_KEY=stripe_secret_key
STRIPE_PUBLIC_KEY=stripe_public_key
STRIPE_WEBHOOK_SECRET=stripe_webhook_secret
STRIPE_API_VERSION=2024-06-20

FEDAPAY_API_KEY=fedapay_api_key
FEDAPAY_PUBLIC_KEY=fedapay_public_key
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_WEBHOOK_TOKEN=fedapay_webhook_token
FEDAPAY_MERCHANT_NAME=Merchant Name
FEDAPAY_MERCHANT_EMAIL=merchant@your-domain.com
FEDAPAY_MERCHANT_PHONE=+22900000000

PAYMENT_SUCCESS_URL=https://your-frontend-domain.com/payment/success
PAYMENT_CANCEL_URL=https://your-frontend-domain.com/payment/cancel
PAYMENT_WEBHOOK_URL=https://your-api.up.railway.app/api/v1/payments/webhook

PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
PDF_TEMP_DIR=/tmp
PDF_PAGE_SIZE=A4
PDF_MARGIN=10

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TIMEOUT_MS=15000
OPENAI_TEMPERATURE=0.3

BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_TIMEOUT_MS=10000
BREVO_RETRY_MAX_ATTEMPTS=3
BREVO_RETRY_BASE_DELAY_MS=200
BREVO_RETRY_MAX_DELAY_MS=2000
DEFAULT_FROM_EMAIL=noreply@your-domain.com
DEFAULT_FROM_NAME=Orientation API
BREVO_TEMPLATE_EMAIL_VERIFICATION_ID=
BREVO_TEMPLATE_PASSWORD_RESET_ID=
FRONTEND_URL=https://your-frontend-domain.com
