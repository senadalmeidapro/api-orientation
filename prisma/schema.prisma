generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// ENUMS
// =====================================================

enum RiasecType {
  R // Réaliste
  I // Investigateur
  A // Artistique
  S // Social
  E // Entreprenant
  C // Conventionnel
}

/// Sert à la fois pour le type d'un Assessment (test complet) et
/// pour la catégorie d'une Question isolée. FULL n'est pertinent
/// qu'au niveau Assessment (un assessment "FULL" regroupe des
/// questions de plusieurs catégories) ; une Question individuelle
/// ne doit jamais avoir category = FULL (à valider côté application).
enum TestType {
  GENERALE
  OCCUPATIONS
  APTITUDES
  PERSONALITY
  FULL
}

enum TestStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum BadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum ProfileStrength {
  TRES_FAIBLE
  FAIBLE
  MOYEN
  FORT
  TRES_FORT
  EXCEPTIONNEL
}

enum ConsistencyLevel {
  FAIBLE // 1
  MOYENNE // 2
  FORTE // 3
}

enum CareerCategory {
  NUMERIQUE
  AGRICULTURE
  ARTISANAT
  SANTE
  EDUCATION
  COMMERCE
  ADMINISTRATION
}

enum FeedbackType {
  LIKE
  DISLIKE
  CLICK
  VIEW
  SKIP
}

enum InteractionEventType {
  ANSWER
  CLICK
  VIEW
  SKIP
}

enum InteractionEntityType {
  QUESTION
  CAREER
  RECOMMENDATION
}

enum OutcomeStatus {
  STUDENT
  INTERNSHIP
  EMPLOYED
  DROPOUT
}

enum UserRole {
  ADMIN
  AGENT
  USER
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
}

enum ScholarshipRecordStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ScholarshipRecordFundingType {
  FULL
  PARTIAL
  TUITION_ONLY
  LIVING_ONLY
  TRANSPORT_ONLY
  OTHER
}

enum ScholarshipRecordApplicationMode {
  ONLINE
  EMAIL
  PHYSICAL
  MIXED
}

enum TokenType {
  REFRESH
  EMAIL_VERIFY
  PASSWORD_RESET
  MFA
}

// =====================================================
// UTILISATEURS
// =====================================================

model User {
  id    String  @id @default(cuid())
  email String? @unique

  firstName   String? @map("first_name") @db.VarChar(100)
  lastName    String? @map("last_name") @db.VarChar(100)
  displayName String? @map("display_name") @db.VarChar(150)
  bio         String? @db.Text

  password  String?
  isDeleted Boolean    @default(false) @map("is_deleted")
  role      UserRole   @default(USER)
  status    UserStatus @default(ACTIVE)

  // Gamification cumulée : persiste à travers toutes les sessions de
  // l'utilisateur (contrairement à Session.totalXp/level qui ne reflète
  // que la session en cours). À la liaison d'une session anonyme à ce
  // compte, l'application additionne les compteurs de session ici.
  totalXp Int @default(0) @map("total_xp")
  level   Int @default(1)

  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  roleAssignedAt  DateTime? @map("role_assigned_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  authAccounts AuthAccount[]
  authSessions Session[]
  tokens       Token[]
  scholarships ScholarshipUser[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model AuthAccount {
  id                  String       @id @default(uuid())
  userId              String       @map("user_id")
  provider            AuthProvider
  providerAccountId   String       @map("provider_account_id") @db.VarChar(255)
  providerEmail       String       @map("provider_email") @db.VarChar(255)
  accessToken         String?      @map("access_token") @db.Text
  refreshToken        String?      @map("refresh_token") @db.Text
  accessTokenExpires  DateTime?    @map("access_token_expires")
  refreshTokenExpires DateTime?    @map("refresh_token_expires")
  scope               String?      @db.VarChar(500)
  idToken             String?      @map("id_token") @db.Text
  sessionState        String?      @map("session_state") @db.VarChar(500)

  providerMetadata Json? @map("provider_metadata")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
  @@map("auth_accounts")
}

/// Fusion de l'ancien AuthToken (refresh token, 1 par user) et de
/// l'ancien Token (multi-usage : email verify, reset password, MFA...).
/// Un même modèle, tokenType distingue l'usage. Si tu veux forcer un
/// seul refresh token actif par user, ajoute une contrainte applicative
/// (invalider les anciens à la création d'un nouveau) plutôt qu'une
/// table dédiée.
model Token {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash")
  tokenType TokenType @map("token_type") // REFRESH, EMAIL_VERIFY, PASSWORD_RESET, MFA...

  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  invalidatedAt DateTime? @map("invalidated_at")

  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.Text
  metadata  Json?

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([userId, tokenType])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([tokenHash, tokenType])
  @@map("tokens")
}

// =====================================================
// VERSIONING
// =====================================================

model TestVersion {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  description String? @db.Text
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  questions   Question[]
  assessments Assessment[]

  @@index([isActive])
  @@map("test_versions")
}

// =====================================================
// SESSIONS (CONTAINER UTILISATEUR)
// =====================================================

model Session {
  id String @id @default(uuid())

  userId String? @map("user_id")

  sessionToken String  @unique @map("session_token")
  sessionHash  String  @map("session_hash")
  shareToken   String? @unique @map("share_token") // Partage du profil/résultats de CETTE session

  isActive  Boolean  @default(true) @map("is_active")
  isCurrent Boolean  @default(false) @map("is_current")
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Gamification live de la session en cours (remise à zéro à chaque
  // nouvelle session ; le cumul persistant vit sur User.totalXp/level).
  totalXp Int @default(0) @map("total_xp")
  level   Int @default(1)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  assessments Assessment[]
  badges      SessionBadge[]
  xpHistory   XPHistory[]

  @@index([sessionToken])
  @@index([shareToken])
  @@index([userId])
  @@map("auth_sessions")
}

// =====================================================
// INSTANCE D'UN TEST (ASSESSMENT)
// =====================================================

model Assessment {
  id String @id @default(uuid())

  sessionId String  @map("session_id")
  session   Session @relation(fields: [sessionId], references: [id])

  testVersionId Int         @map("test_version_id")
  testVersion   TestVersion @relation(fields: [testVersionId], references: [id], onDelete: Restrict)

  type   TestType
  depth  Int // Nombre de questions par axe RIASEC (ex: 10 = profond, 5 = moyen, 3 = léger)
  status TestStatus @default(IN_PROGRESS)

  // Progression : catégorie en cours (null si le test ne couvre qu'une
  // seule catégorie).
  currentCategory  TestType? @map("current_category")
  currentStepIndex Int       @default(0) @map("current_step_index")

  // Système adaptatif par lots
  batchSize    Int @default(5) @map("batch_size")
  currentBatch Int @default(0) @map("current_batch")

  adaptiveState Json? @map("adaptive_state") // { "probabilities": { "R": 0.3, ... }, "askedQuestions": [...] }

  startedAt      DateTime  @default(now()) @map("started_at")
  lastActivityAt DateTime  @updatedAt @map("last_activity_at")
  completedAt    DateTime? @map("completed_at")

  completionPercentage Int @default(0) @map("completion_percentage")

  // Relations
  responses            Response[]
  result               AssessmentResult?
  treasureMap          TreasureMap?
  feedbacks            AssessmentFeedback[]
  outcomes             AssessmentOutcome[]
  interactions         AssessmentInteraction[]
  xpHistory            XPHistory[]
  batches              BatchHistory[]
  intermediateProfiles IntermediateProfile[]

  @@index([sessionId])
  @@index([testVersionId])
  @@index([type])
  @@index([status])
  @@index([startedAt])
  @@map("assessments")
}

// =====================================================
// QUESTIONS ET RÉPONSES
// =====================================================

model RiasecTypeModel {
  id           RiasecType @id
  name         String
  slogan       String?
  description  String?
  colorHex     String?    @map("color_hex")
  iconUrl      String?    @map("icon_url")
  displayOrder Int        @default(0) @map("display_order")

  questions Question[]

  @@map("riasec_types")
}

model Question {
  id            Int             @id @default(autoincrement())
  riasecTypeId  RiasecType      @map("riasec_type_id")
  riasecType    RiasecTypeModel @relation(fields: [riasecTypeId], references: [id])
  testVersionId Int             @map("test_version_id")
  testVersion   TestVersion     @relation(fields: [testVersionId], references: [id], onDelete: Cascade)

  category TestType @map("category") // GENERALE, OCCUPATIONS, APTITUDES, PERSONALITY

  questionText String  @map("question_text") @db.Text
  subtitle     String? @map("subtitle") // texte court / complément d'affichage
  mediaUrl     String? @map("media_url") // illustration ou média associé
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  minValue    Int?  @default(1) @map("min_value")
  maxValue    Int?  @default(3) @map("max_value")
  valueLabels Json? @map("value_labels") // { "1": "Faible 😕", "2": "Moyen 😐", "3": "Fort 😊" }

  pointsValue Int @default(15) @map("points_value")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  responses Response[]
  profiles  QuestionProfile[]

  @@unique([testVersionId, category, displayOrder])
  @@index([riasecTypeId])
  @@index([testVersionId])
  @@index([category])
  @@map("questions")
}

model Response {
  id           String     @id @default(uuid())
  assessmentId String     @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId   Int        @map("question_id")
  question     Question   @relation(fields: [questionId], references: [id])

  // 0/1 pour GENERALE/OCCUPATIONS/PERSONALITY, 1-3 pour APTITUDES
  responseValue  Int  @map("response_value")
  responseTimeMs Int? @map("response_time_ms")

  // Tracking comportemental (fusionné depuis l'ancien BehavioralIndicator)
  timeTakenMs     Int?     @map("time_taken_ms")
  changeCount     Int      @default(0) @map("change_count")
  behavioralFlags String[] @default([]) @map("behavioral_flags") // 'hesitation', 'doubt', 'excitement', 'consistent'...
  metadata        Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
  @@index([questionId])
  @@map("responses")
}

// =====================================================
// SYSTÈME ADAPTATIF - PROFILS PAR QUESTION
// =====================================================

/// Pondération d'une question sur un ou plusieurs axes RIASEC pour le
/// scoring adaptatif fin (une question peut contribuer à plusieurs
/// types à la fois, ex: 0.8 sur R et 0.2 sur I). Question.riasecTypeId
/// reste l'axe primaire pour l'affichage/filtrage simple.
model QuestionProfile {
  id         Int        @id @default(autoincrement())
  questionId Int        @map("question_id")
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  riasecType RiasecType @map("riasec_type")
  category   TestType   @map("category") // GENERALE, OCCUPATIONS, APTITUDES, PERSONALITY
  weight     Float

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([questionId, riasecType])
  @@index([questionId])
  @@index([riasecType])
  @@map("question_profiles")
}

// =====================================================
// SYSTÈME ADAPTATIF - GESTION DES LOTS
// =====================================================

model BatchHistory {
  id           String     @id @default(uuid())
  assessmentId String     @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  batchIndex  Int   @map("batch_index")
  questionIds Int[] @map("question_ids")

  presentedAt DateTime  @default(now()) @map("presented_at")
  completedAt DateTime? @map("completed_at")

  @@unique([assessmentId, batchIndex])
  @@index([assessmentId])
  @@index([batchIndex])
  @@map("batch_history")
}

// =====================================================
// PROFILS INTERMÉDIAIRES (APRÈS CHAQUE LOT)
// =====================================================

model IntermediateProfile {
  id           String     @id @default(uuid())
  assessmentId String     @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  batchIndex Int @map("batch_index")

  profileData Json  @map("profile_data") // { "R": 0.3, "I": 0.2, "A": 0.15, "S": 0.1, "E": 0.15, "C": 0.1 }
  rawScores   Json? @map("raw_scores")

  calculatedAt DateTime @default(now()) @map("calculated_at")

  @@unique([assessmentId, batchIndex])
  @@index([assessmentId])
  @@index([batchIndex])
  @@map("intermediate_profiles")
}

// =====================================================
// RÉSULTATS D'UN ASSESSMENT
// =====================================================

model AssessmentResult {
  id           String     @id @default(uuid())
  assessmentId String     @unique @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  riasecCode        String? @map("riasec_code") @db.Char(3)
  subjectiveRanking Json?   @map("subjective_ranking")

  // { "GENERALE": { "R": 5, ... }, "OCCUPATIONS": {...}, "APTITUDES": {...}, "PERSONALITY": {...} }
  scoresByCategory Json? @map("scores_by_category")

  consistencyScore     Float?            @map("consistency_score")
  consistencyLevel     ConsistencyLevel? @map("consistency_level")
  differentiationScore Float?            @map("differentiation_score")
  profileStrength      ProfileStrength?  @map("profile_strength")

  insights   Json?
  strengths  String[]
  weaknesses String[]

  createdAt    DateTime  @default(now()) @map("created_at")
  lastViewedAt DateTime? @map("last_viewed_at")
  viewCount    Int       @default(0) @map("view_count")

  careerRecommendations               AssessmentCareerRecommendation[]
  assessmentFormationRecommendations  AssessmentFormationRecommendation[]
  assessmentUniversityRecommendations AssessmentUniversityRecommendation[]

  @@index([assessmentId])
  @@index([riasecCode])
  @@index([consistencyLevel])
  @@index([createdAt])
  @@map("assessment_results")
}

// =====================================================
// MÉTIERS ET RECOMMANDATIONS
// =====================================================

model Career {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String  @db.Text
  summary     String?

  riasecCodes RiasecType[] @map("riasec_codes")

  localDemand    Int?    @map("local_demand")
  formationLevel String? @map("formation_level")
  salaryRangeMin Int?    @map("salary_range_min")
  salaryRangeMax Int?    @map("salary_range_max")
  careerPath     String? @map("career_path")

  iconUrl  String? @map("icon_url")
  imageUrl String? @map("image_url")
  videoUrl String? @map("video_url")

  category CareerCategory?
  tags     String[]

  isFeatured Boolean @default(false) @map("is_featured")
  isActive   Boolean @default(true) @map("is_active")
  viewCount  Int     @default(0) @map("view_count")
  clickCount Int     @default(0) @map("click_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recommendations AssessmentCareerRecommendation[]
  institutions    CareerFormation[]
  resources       CareerResource[]
  outcomes        AssessmentOutcome[]

  @@index([category])
  @@index([isFeatured])
  @@index([isActive, category])
  @@map("careers")
}

model CareerFormation {
  careerId    Int       @map("career_id")
  career      Career    @relation(fields: [careerId], references: [id], onDelete: Cascade)
  formationId Int       @map("formation_id")
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  isPrimary   Boolean   @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")

  @@id([careerId, formationId])
  @@index([formationId])
  @@map("career_formation")
}

model CareerResource {
  careerId   Int      @map("career_id")
  career     Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  resourceId Int      @map("resource_id")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([careerId, resourceId])
  @@index([resourceId])
  @@map("career_resources")
}

model AssessmentCareerRecommendation {
  id       String           @id @default(uuid())
  resultId String           @map("result_id")
  result   AssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  careerId Int              @map("career_id")
  career   Career           @relation(fields: [careerId], references: [id], onDelete: Cascade)

  matchScore   Int @map("match_score")
  rankPosition Int @map("rank_position")

  viewedAt      DateTime? @map("viewed_at")
  savedForLater Boolean   @default(false) @map("saved_for_later")

  createdAt DateTime @default(now()) @map("created_at")

  feedbacks AssessmentFeedback[]

  @@unique([resultId, careerId])
  @@index([resultId])
  @@index([careerId])
  @@index([matchScore])
  @@map("assessment_career_recommendations")
}

// =====================================================
// GAMIFICATION (AU NIVEAU SESSION)
// =====================================================

model Badge {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  description String  @db.Text
  iconUrl     String? @map("icon_url")
  emoji       String?

  rarity      BadgeRarity @default(COMMON)
  pointsValue Int         @default(50) @map("points_value")

  unlockCondition Json? @map("unlock_condition")

  unlockCount Int @default(0) @map("unlock_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessionBadges SessionBadge[]

  @@index([rarity])
  @@map("badges")
}

model SessionBadge {
  id        String  @id @default(uuid())
  sessionId String  @map("session_id")
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  badgeId   Int     @map("badge_id")
  badge     Badge   @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  unlockedAt     DateTime @default(now()) @map("unlocked_at")
  sharedOnSocial Boolean  @default(false) @map("shared_on_social")

  @@unique([sessionId, badgeId])
  @@index([sessionId])
  @@index([badgeId])
  @@map("session_badges")
}

model XPHistory {
  id        String  @id @default(uuid())
  sessionId String  @map("session_id")
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  amount       Int
  reason       String?
  assessmentId String?     @map("assessment_id")
  assessment   Assessment? @relation(fields: [assessmentId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([createdAt])
  @@map("xp_history")
}

// =====================================================
// CARTE AU TRÉSOR
// =====================================================

model TreasureMap {
  id           String     @id @default(uuid())
  assessmentId String     @unique @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  mapData    Json    @map("map_data")
  pdfUrl     String? @map("pdf_url")
  shareToken String  @unique @map("share_token") // Partage d'UN résultat précis (distinct de Session.shareToken)

  viewCount     Int @default(0) @map("view_count")
  downloadCount Int @default(0) @map("download_count")

  createdAt    DateTime  @default(now()) @map("created_at")
  lastViewedAt DateTime? @map("last_viewed_at")

  @@index([shareToken])
  @@map("treasure_maps")
}

// =====================================================
// FEEDBACK & OUTCOMES (AU NIVEAU ASSESSMENT)
// =====================================================

model AssessmentFeedback {
  id String @id @default(uuid())

  assessmentId String     @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  recommendationId String?
  recommendation   AssessmentCareerRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  type  FeedbackType
  value Float

  context Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([assessmentId])
  @@index([recommendationId])
  @@index([type])
  @@map("assessment_feedbacks")
}

model AssessmentOutcome {
  id String @id @default(uuid())

  assessmentId String     @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  careerId Int    @map("career_id")
  career   Career @relation(fields: [careerId], references: [id], onDelete: Cascade)

  status         OutcomeStatus
  sector         String
  salaryRange    String?       @map("salary_range")
  delayToOutcome Int           @map("delay_to_outcome")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([assessmentId])
  @@index([careerId])
  @@index([status])
  @@map("assessment_outcomes")
}

// =====================================================
// INTERACTIONS POUR ADAPTATION
// =====================================================

model AssessmentInteraction {
  id           BigInt                @id @default(autoincrement())
  assessmentId String                @map("assessment_id")
  assessment   Assessment            @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  type         InteractionEventType
  entityType   InteractionEntityType @map("entity_type")
  entityId     Int                   @map("entity_id")
  value        Float?
  metadata     Json?
  createdAt    DateTime              @default(now()) @map("created_at")

  @@index([assessmentId])
  @@index([type])
  @@index([entityType])
  @@index([createdAt])
  @@map("assessment_interactions")
}

// =====================================================
// CONTENU ÉDUCATIF
// =====================================================

model Resource {
  id          Int    @id @default(autoincrement())
  title       String
  description String @db.Text
  content     String @db.Text
  contentType String @map("content_type") // 'ARTICLE', 'VIDEO', 'PDF', 'LINK'

  thumbnailUrl String? @map("thumbnail_url")
  mediaUrl     String? @map("media_url")

  category String?
  tags     String[]

  author      String?
  viewCount   Int       @default(0) @map("view_count")
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  relatedCareers CareerResource[]

  @@index([category])
  @@index([isPublished])
  @@map("resources")
}

// =====================================================
// UNIVERSITÉS ET FORMATIONS
// =====================================================

model University {
  id          Int    @id @default(autoincrement())
  name        String @unique
  acronym     String @unique
  description String @db.Text

  phone   String? @unique
  email   String? @unique
  website String

  department String?
  city       String?
  address    String?
  latitude   Float?
  longitude  Float?

  logoUrl       String?  @map("logo_url")
  coverUrl      String?  @map("cover_url")
  formationUrls String[] @map("formation_urls")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  formations                          Formation[]
  scholarships                        UniversityScholarship[]
  media                               UniversityMedia[]
  assessmentUniversityRecommendations AssessmentUniversityRecommendation[]

  @@index([isActive])
  @@map("universities")
}

model UniversityMedia {
  id           Int        @id @default(autoincrement())
  universityId Int        @map("university_id")
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  mediaUrl String @map("media_url")
  order    Int    @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([universityId])
  @@map("university_media")
}

model Formation {
  id          Int     @id @default(autoincrement())
  title       String
  description String  @db.Text
  duration    String
  degree      String
  field       String?
  link        String?

  costMin Int? @map("cost_min")
  costMax Int? @map("cost_max")

  programs String[]

  universityId Int?        @map("university_id")
  university   University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  career                             CareerFormation[]
  assessmentFormationRecommendations AssessmentFormationRecommendation[]

  @@index([universityId])
  @@index([isActive])
  @@map("formations")
}

model UniversityScholarship {
  universityId  Int         @map("university_id")
  university    University  @relation(fields: [universityId], references: [id], onDelete: Cascade)
  scholarshipId Int         @map("scholarship_id")
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([universityId, scholarshipId])
  @@index([scholarshipId])
  @@map("university_scholarships")
}

model ScholarshipUser {
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarshipId Int         @map("scholarship_id")
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, scholarshipId])
  @@index([scholarshipId])
  @@map("scholarship_user")
}

model Scholarship {
  id          Int    @id @default(autoincrement())
  title       String
  description String @db.Text
  provider    String

  code          String? @unique
  referenceCode String? @map("reference_code")
  level         String?
  field         String?
  country       String?
  city          String?

  status          ScholarshipRecordStatus          @default(PUBLISHED)
  fundingType     ScholarshipRecordFundingType?    @map("funding_type")
  applicationMode ScholarshipRecordApplicationMode @default(ONLINE) @map("application_mode")

  currency        String? @db.VarChar(10)
  amountLabel     String? @map("amount_label")
  amountMin       String? @map("amount_min")
  amountMax       String? @map("amount_max")
  coveragePercent Float?  @map("coverage_percent")
  applicationFee  Int?    @map("application_fee")
  seats           Int?

  isRenewable             Boolean? @map("is_renewable")
  renewableDurationMonths Int?     @map("renewable_duration_months")
  interviewRequired       Boolean? @default(false) @map("interview_required")

  benefits   String[] @default([])
  conditions String[] @default([])

  eligibilityCriteria Json? @map("eligibility_criteria")
  requiredDocuments   Json? @map("required_documents")
  modalities          Json?
  selectionProcess    Json? @map("selection_process")
  contactInfo         Json? @map("contact_info")

  applicationUrl          String?   @map("application_url")
  applicationEmail        String?   @map("application_email")
  applicationPhone        String?   @map("application_phone")
  applicationInstructions String?   @map("application_instructions") @db.Text
  startDate               DateTime? @map("start_date")
  endDate                 DateTime? @map("end_date")
  applicationOpenAt       DateTime? @map("application_open_at")
  applicationCloseAt      DateTime? @map("application_close_at")
  resultDate              DateTime? @map("result_date")

  user         ScholarshipUser[]
  universities UniversityScholarship[]

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([isActive])
  @@index([country])
  @@index([field])
  @@index([applicationCloseAt])
  @@map("scholarship_records")
}

model AssessmentFormationRecommendation {
  id          String           @id @default(uuid())
  resultId    String           @map("result_id")
  result      AssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  formationId Int              @map("formation_id")
  formation   Formation        @relation(fields: [formationId], references: [id], onDelete: Cascade)

  matchScore   Int @map("match_score")
  rankPosition Int @map("rank_position")

  viewedAt      DateTime? @map("viewed_at")
  savedForLater Boolean   @default(false) @map("saved_for_later")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([resultId, formationId])
  @@index([resultId])
  @@index([formationId])
  @@index([matchScore])
  @@map("assessment_formation_recommendations")
}

model AssessmentUniversityRecommendation {
  id           String           @id @default(uuid())
  resultId     String           @map("result_id")
  result       AssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  universityId Int              @map("university_id")
  university   University       @relation(fields: [universityId], references: [id], onDelete: Cascade)

  matchScore   Int @map("match_score")
  rankPosition Int @map("rank_position")

  viewedAt      DateTime? @map("viewed_at")
  savedForLater Boolean   @default(false) @map("saved_for_later")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([resultId, universityId])
  @@index([resultId])
  @@index([universityId])
  @@index([matchScore])
  @@map("assessment_university_recommendations")
}
