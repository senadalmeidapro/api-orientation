generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// TYPES DE BASE ET ÉNUMÉRATIONS
// =====================================================

enum RiasecType {
  R // Réaliste
  I // Investigateur
  A // Artistique
  S // Social
  E // Entreprenant
  C // Conventionnel
}

enum PhaseType {
  PHASE_1
  PHASE_2
  PHASE_3
}

enum SectionType {
  OCCUPATIONS
  APTITUDES
  PERSONALITY
}

enum BadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum ProfileStrength {
  TRES_FAIBLE
  FAIBLE
  MOYEN
  FORT
  TRES_FORT
  EXCEPTIONNEL
}

enum ConsistencyLevel {
  FAIBLE // 1
  MOYENNE // 2
  FORTE // 3
}

enum Departement {
  Alibori
  Atacora
  Atlantique
  Borgou
  Collines
  Couffo
  Donga
  Littoral
  Mono
  Oueme
  Plateau
  Zou
}

enum Gender {
  M
  F
  Other
}

enum UserRole {
  ADMIN
  EDITOR
  ANALYST
}

enum Theme {
  light
  dark
  system
}

enum FontSize {
  small
  medium
  large
}

enum Label {
  Faible
  Moyen
  Fort
}

enum CareerCategory {
  NUMERIQUE
  AGRICULTURE
  ARTISANAT
  SANTE
  EDUCATION
  COMMERCE
  ADMINISTRATION
}

enum RequestType {
  INFO
  RENDEZ_VOUS
  QUESTION
  AUTRE
}

enum PreferredTime {
  MATIN
  APRES_MIDI
  SOIR
}

enum ContactSatus {
  PENDING
  CONTACTED
  RESOLVED
}

enum AnnouncementType {
  INFO
  EVENT
  ALERTE
  PROMO
}

enum TargetAudience {
  ALL
  STUDENTS
  PARENTS
  TEACHERS
}

enum FeedbackType {
  LIKE
  DISLIKE
  CLICK
  VIEW
  SKIP
}

enum InteractionEventType {
  ANSWER
  CLICK
  VIEW
  SKIP
}

enum InteractionEntityType {
  QUESTION
  CAREER
  RECOMMENDATION
}

enum OutcomeStatus {
  STUDENT
  INTERNSHIP
  EMPLOYED
  DROPOUT
}

// =====================================================
// VERSIONING & LOCALISATION
// =====================================================

model TestVersion {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  description String? @db.Text
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phase1Questions Phase1Question[]
  phase2Questions Phase2Question[]
  sessions        UserTestSession[]

  @@index([isActive])
  @@map("test_versions")
}

model Language {
  id         Int     @id @default(autoincrement())
  code       String  @unique // fr, fon, yoruba, etc.
  name       String
  nativeName String?
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phase1QuestionTranslations Phase1QuestionTranslation[]
  phase2QuestionTranslations Phase2QuestionTranslation[]
  careerTranslations         CareerTranslation[]
  resourceTranslations       ResourceTranslation[]
  announcementTranslations   AnnouncementTranslation[]
  institutionTranslations    TrainingInstitutionTranslation[]

  @@index([isActive])
  @@map("languages")
}

// =====================================================
// TABLES PRINCIPALES
// =====================================================

// Utilisateurs de la plateforme
model User {
  id         String       @id @default(uuid())
  email      String       @unique
  phone      String?      @unique
  password   String
  firstName  String?
  lastName   String?
  birthDate  DateTime?
  gender     Gender?
  department Departement?
  city       String?
  school     String? // Établissement scolaire
  level      String? // Niveau d'étude (3e, Terminale, etc.)

  // Préférences
  preferredLanguage   String  @default("fr") // fr, fon, yoruba, etc.
  acceptNotifications Boolean @default(true)

  // Métadonnées
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  lastLoginAt DateTime?
  isActive    Boolean    @default(true)
  isAdmin     Boolean    @default(false)
  roles       UserRole[] @default([])

  // Relations
  testSessions         UserTestSession[]
  badges               UserBadge[]
  savedCareers         SavedCareer[]
  feedbacks            UserFeedback[]
  outcomes             UserOutcome[]
  userFeature          UserFeature?
  interactionEvents    InteractionEvent[]
  recommendationScores RecommendationScore[]
  settings             UserSettings?
  contactRequests      ContactRequest[]
  xpEvents             UserXP[]
  userLevel            UserLevel?
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  auditLogs            AdminAuditLog[]

  @@index([email])
  @@index([phone])
  @@index([department])
  @@index([createdAt])
}

// Paramètres utilisateur
model UserSettings {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Préférences d'affichage
  theme    Theme    @default(light)
  fontSize FontSize @default(medium)

  // Confidentialité
  shareResults Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// SESSIONS DE TEST
// =====================================================

// Sessions de test (une par parcours utilisateur)
model UserTestSession {
  id            String      @id @default(uuid())
  userId        String? // Null si non connecté
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  testVersionId Int
  testVersion   TestVersion @relation(fields: [testVersionId], references: [id], onDelete: Restrict)

  // Identifiants
  sessionToken String  @unique
  shareToken   String? @unique // Pour partage public

  // Progression
  currentPhase     PhaseType    @default(PHASE_1)
  currentStepIndex Int          @default(0)
  currentSection   SectionType? // Pour phase 2
  department       Departement?

  // Timestamps
  startedAt         DateTime  @default(now())
  lastActivityAt    DateTime  @updatedAt
  completedAt       DateTime?
  phase1CompletedAt DateTime?
  phase2CompletedAt DateTime?
  phase3CompletedAt DateTime?

  // État
  isAbandoned          Boolean @default(false)
  completionPercentage Int     @default(0)

  // Métadonnées
  deviceInfo Json? // Infos sur l'appareil (OS, navigateur, etc.)
  ipAddress  String? // @db.Inet?
  userAgent  String?

  // Relations
  phase1Responses Phase1Response[]
  phase2Responses Phase2Response[]
  result          UserResult?
  treasureMap     TreasureMap?
  feedbacks       UserFeedback[]
  userBadges      UserBadge[]
  xpEvents        UserXP[]

  @@index([userId])
  @@index([testVersionId])
  @@index([sessionToken])
  @@index([shareToken])
  @@index([startedAt])
  @@index([isAbandoned])
  @@index([completionPercentage])
  @@index([department])
}

// =====================================================
// QUESTIONS ET RÉPONSES
// =====================================================

// Types RIASEC (R, I, A, S, E, C)
model RiasecTypeModel {
  id           RiasecType @id // 'R', 'I', 'A', 'S', 'E', 'C'
  name         String // 'Réaliste', 'Investigateur', etc.
  slogan       String?
  description  String? // Description longue
  colorHex     String? // Code couleur pour UI
  iconUrl      String? // URL de l'icône
  displayOrder Int        @default(0)

  // Relations
  phase1Questions Phase1Question[]
  phase2Questions Phase2Question[]

  @@map("riasec_types")
}

// Questions de la Phase 1 (Amorce)
model Phase1Question {
  id            Int             @id @default(autoincrement())
  riasecTypeId  RiasecType
  riasecType    RiasecTypeModel @relation(fields: [riasecTypeId], references: [id])
  testVersionId Int
  testVersion   TestVersion     @relation(fields: [testVersionId], references: [id], onDelete: Cascade)

  questionText    String  @db.Text
  questionShort   String? // Version courte pour mobile
  illustrationUrl String? // Image ou icône associée
  displayOrder    Int     @default(0)
  isActive        Boolean @default(true)

  // Gamification
  pointsValue Int @default(10) // Points gagnés en répondant

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  responses    Phase1Response[]
  translations Phase1QuestionTranslation[]

  @@unique([testVersionId, displayOrder])
  @@index([riasecTypeId])
  @@index([testVersionId])
  @@index([displayOrder])
  @@index([isActive])
  @@map("phase1_questions")
}

// Questions de la Phase 2 (Approfondissement)
model Phase2Question {
  id            Int             @id @default(autoincrement())
  riasecTypeId  RiasecType
  riasecType    RiasecTypeModel @relation(fields: [riasecTypeId], references: [id])
  testVersionId Int
  testVersion   TestVersion     @relation(fields: [testVersionId], references: [id], onDelete: Cascade)

  sectionType     SectionType // 'OCCUPATIONS', 'APTITUDES', 'PERSONALITY'
  questionText    String      @db.Text
  questionSubtext String? // Sous-titre ou indication
  mediaUrl        String? // Image ou vidéo courte
  displayOrder    Int         @default(0)
  isActive        Boolean     @default(true)

  // Pour les aptitudes (échelle 1-3)
  minValue    Int?  @default(1)
  maxValue    Int?  @default(3)
  valueLabels Json? // { "1": "Faible 😕", "2": "Moyen 😐", "3": "Fort 😊" }

  // Gamification
  pointsValue Int @default(15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  responses    Phase2Response[]
  translations Phase2QuestionTranslation[]

  @@unique([testVersionId, sectionType, displayOrder])
  @@index([riasecTypeId])
  @@index([testVersionId])
  @@index([sectionType])
  @@index([isActive])
  @@map("phase2_questions")
}

// Traductions des questions Phase 1
model Phase1QuestionTranslation {
  id         Int            @id @default(autoincrement())
  questionId Int
  question   Phase1Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  languageId Int
  language   Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)

  questionText  String  @db.Text
  questionShort String?
  audioUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([questionId, languageId])
  @@index([languageId])
  @@map("phase1_question_translations")
}

// Traductions des questions Phase 2
model Phase2QuestionTranslation {
  id         Int            @id @default(autoincrement())
  questionId Int
  question   Phase2Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  languageId Int
  language   Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)

  questionText    String  @db.Text
  questionSubtext String?
  audioUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([questionId, languageId])
  @@index([languageId])
  @@map("phase2_question_translations")
}

// Options de réponse pour les échelles d'aptitude
model AptitudeResponseOption {
  id        Int     @id @default(autoincrement())
  value     Int     @unique // 1, 2, 3
  label     Label // 'Faible', 'Moyen', 'Fort'
  emoji     String? // '😕', '😐', '😊'
  colorCode String? // '#FF4444', '#FFA500', '#4CAF50'

  @@map("aptitude_response_options")
}

// Réponses de la Phase 1
model Phase1Response {
  id         Int             @id @default(autoincrement())
  sessionId  String
  session    UserTestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId Int
  question   Phase1Question  @relation(fields: [questionId], references: [id])

  responseValue  Int // 0 pour non, 1 pour oui
  responseTimeMs Int? // Temps de réponse (ms)

  createdAt DateTime @default(now())

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
  @@index([createdAt])
  @@map("phase1_responses")
}

// Réponses de la Phase 2
model Phase2Response {
  id         Int             @id @default(autoincrement())
  sessionId  String
  session    UserTestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId Int
  question   Phase2Question  @relation(fields: [questionId], references: [id])

  responseValue  Int // Pour occupations: 0/1; aptitudes: 1-3; personality: 0/1
  responseTimeMs Int? // Temps de réponse

  createdAt DateTime @default(now())

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
  @@index([createdAt])
  @@map("phase2_responses")
}

// =====================================================
// RÉSULTATS ET CALCULS
// =====================================================

// Résultats calculés du test
model UserResult {
  id        Int             @id @default(autoincrement())
  sessionId String          @unique
  session   UserTestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Codes
  phase1Code        String @db.Char(3) // Ex: "RIA"
  phase2Code        String @db.Char(3) // Ex: "RIS"
  subjectiveRanking Json? // Classement subjectif des cartes EPCR

  // Scores bruts
  phase1Scores  Json // { "R": 5, "I": 3, "A": 8, "S": 2, "E": 1, "C": 0 }
  phase2Scores  Json // { "R": 15, "I": 22, "A": 18, "S": 10, "E": 5, "C": 8 }
  sectionScores Json // Scores détaillés par section

  // Indicateurs de qualité
  consistencyScore     Float // 1, 2, ou 3
  consistencyLevel     ConsistencyLevel
  differentiationScore Float // Calculé selon formule Vrignaud
  profileStrength      ProfileStrength

  // Interprétations
  insights  Json? // Liste d'insights personnalisés
  strengths String[] // Forces identifiées

  // Métadonnées
  createdAt    DateTime  @default(now())
  lastViewedAt DateTime?
  viewCount    Int       @default(0)

  // Relations
  careerRecommendations UserCareerRecommendation[]

  @@index([sessionId])
  @@index([phase2Code])
  @@index([consistencyLevel])
  @@index([profileStrength])
  @@index([createdAt])
  @@map("user_results")
}

// =====================================================
// MÉTIERS ET RECOMMANDATIONS
// =====================================================

// Métiers (base de données locale)
model Career {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String  @db.Text
  summary     String? // Description courte (pour cartes)

  // Codes RIASEC associés (ex: ['R', 'I'])
  riasecCodes RiasecType[] // Stocké comme tableau PostgreSQL

  // Contexte béninois
  localDemand    Int? // 1-5 (demande au Bénin)
  formationLevel String? // 'CAP', 'BAC', 'BTS', 'Licence', 'EMN', etc.
  salaryRangeMin Int? // En FCFA
  salaryRangeMax Int? // En FCFA
  careerPath     String? // Évolution de carrière possible

  // Médias
  iconUrl  String?
  imageUrl String?
  videoUrl String?

  // Classification
  category CareerCategory? // 'NUMERIQUE', 'AGRICULTURE', 'ARTISANAT', 'SANTE', 'EDUCATION', 'COMMERCE', 'ADMINISTRATION'
  tags     String[] // Tags de recherche

  // Métadonnées
  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)
  viewCount  Int     @default(0)
  clickCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  recommendations      UserCareerRecommendation[]
  savedBy              SavedCareer[]
  institutions         CareerInstitution[]
  resources            CareerResource[]
  translations         CareerTranslation[]
  outcomes             UserOutcome[]
  recommendationScores RecommendationScore[]

  @@index([category])
  @@index([isFeatured])
  @@index([localDemand])
  @@index([riasecCodes])
  @@map("careers")
}

// Relation métiers <-> établissements
model CareerInstitution {
  careerId      Int
  career        Career              @relation(fields: [careerId], references: [id], onDelete: Cascade)
  institutionId Int
  institution   TrainingInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  isPrimary     Boolean             @default(false)

  createdAt DateTime @default(now())

  @@id([careerId, institutionId])
  @@index([institutionId])
  @@map("career_institutions")
}

// Relation métiers <-> ressources
model CareerResource {
  careerId   Int
  career     Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  resourceId Int
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([careerId, resourceId])
  @@index([resourceId])
  @@map("career_resources")
}

// Traductions des métiers
model CareerTranslation {
  id         Int      @id @default(autoincrement())
  careerId   Int
  career     Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  languageId Int
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  name        String
  summary     String?
  description String  @db.Text
  audioUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([careerId, languageId])
  @@index([languageId])
  @@map("career_translations")
}

// Recommandations personnalisées pour un utilisateur
model UserCareerRecommendation {
  id       Int        @id @default(autoincrement())
  resultId Int
  result   UserResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  careerId Int
  career   Career     @relation(fields: [careerId], references: [id], onDelete: Cascade)

  matchScore   Int // Pourcentage de matching (0-100)
  rankPosition Int // Position dans le classement

  viewedAt      DateTime?
  savedForLater Boolean   @default(false)

  createdAt DateTime @default(now())

  feedbacks UserFeedback[]

  @@unique([resultId, careerId])
  @@index([resultId])
  @@index([careerId])
  @@index([matchScore])
  @@index([rankPosition])
  @@map("user_career_recommendations")
}

// Métiers sauvegardés par l'utilisateur (favoris)
model SavedCareer {
  id       Int    @id @default(autoincrement())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerId Int
  career   Career @relation(fields: [careerId], references: [id], onDelete: Cascade)

  notes   String? // Notes personnelles sur ce métier
  savedAt DateTime @default(now())

  @@unique([userId, careerId])
  @@index([userId])
  @@index([careerId])
  @@map("saved_careers")
}

// =====================================================
// GAMIFICATION (BADGES ET RÉCOMPENSES)
// =====================================================

// Définitions des badges
model Badge {
  id          Int     @id @default(autoincrement())
  code        String  @unique // 'EXPLORATEUR', 'BATISSEUR', etc.
  name        String
  description String  @db.Text
  iconUrl     String? // URL de l'icône
  emoji       String? // Fallback emoji

  rarity      BadgeRarity @default(COMMON)
  pointsValue Int         @default(50) // Points d'expérience

  // Condition de déblocage (JSON)
  unlockCondition Json? // { "type": "phase_completion", "phase": 1 }

  // Statistiques
  unlockCount Int @default(0) // Nombre de fois débloqué

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userBadges UserBadge[]

  @@index([rarity])
  @@index([unlockCount])
  @@map("badges")
}

// Badges débloqués par les utilisateurs
model UserBadge {
  id        Int              @id @default(autoincrement())
  userId    String? // Null si non connecté
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String? // Session où le badge a été débloqué
  session   UserTestSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  badgeId   Int
  badge     Badge            @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  unlockedAt     DateTime @default(now())
  sharedOnSocial Boolean  @default(false)

  @@unique([userId, badgeId]) // Un utilisateur ne peut avoir un badge qu'une fois
  @@index([userId])
  @@index([sessionId])
  @@index([badgeId])
  @@index([unlockedAt])
  @@map("user_badges")
}

// Historique des points d'expérience
model UserXP {
  id        Int              @id @default(autoincrement())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  session   UserTestSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  amount Int
  reason String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("user_xp")
}

// Niveau actuel de l'utilisateur
model UserLevel {
  id        Int    @id @default(autoincrement())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     Int    @default(1)
  currentXp Int    @default(0)
  totalXp   Int    @default(0)

  updatedAt DateTime @updatedAt

  @@index([level])
  @@map("user_levels")
}

// =====================================================
// CARTE AU TRÉSOR (RÉSULTAT FINAL PERSONNALISÉ)
// =====================================================

// Refresh tokens (multi-device)
model RefreshToken {
  id        Int    @id @default(autoincrement())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Password reset tokens
model PasswordResetToken {
  id        Int    @id @default(autoincrement())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique

  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Carte au Trésor générée
model TreasureMap {
  id        Int             @id @default(autoincrement())
  sessionId String          @unique
  session   UserTestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Données de la carte (JSON complet)
  mapData    Json // Stockage de tous les éléments visuels
  pdfUrl     String? // URL du PDF généré
  shareToken String  @unique // Pour partage public

  // Statistiques
  viewCount     Int @default(0)
  downloadCount Int @default(0)

  createdAt    DateTime  @default(now())
  lastViewedAt DateTime?

  @@index([shareToken])
  @@index([createdAt])
  @@map("treasure_maps")
}

// =====================================================
// FEEDBACK ET OUTCOMES
// =====================================================

model UserFeedback {
  id Int @id @default(autoincrement())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String?
  session   UserTestSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  recommendationId Int?
  recommendation   UserCareerRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  type  FeedbackType
  value Float

  context Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([recommendationId])
  @@index([type])
  @@index([createdAt])
  @@map("user_feedbacks")
}

model UserOutcome {
  id Int @id @default(autoincrement())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  careerId Int
  career   Career @relation(fields: [careerId], references: [id], onDelete: Cascade)

  status         OutcomeStatus
  sector         String
  salaryRange    String?
  delayToOutcome Int

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([careerId])
  @@index([status])
  @@index([createdAt])
  @@map("user_outcomes")
}

// =====================================================
// ADAPTIVE RECOMMENDATIONS
// =====================================================

model UserFeature {
  id                Int      @id @default(autoincrement())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avgResponseTime   Float    @default(0)
  responseVariance  Float    @default(0)
  completionRate    Float    @default(0)
  riasecConsistency Float    @default(0)
  explorationScore  Float    @default(0)
  lastUpdatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("user_features")
}

model InteractionEvent {
  id         BigInt                @id @default(autoincrement())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       InteractionEventType
  entityType InteractionEntityType
  entityId   Int
  value      Float?
  metadata   Json?
  createdAt  DateTime              @default(now())

  @@index([userId])
  @@index([type])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("interaction_events")
}

model RecommendationScore {
  id           Int      @id @default(autoincrement())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerId     Int
  career       Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  score        Float
  confidence   Float
  modelVersion String
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([careerId])
  @@index([modelVersion])
  @@index([createdAt])
  @@map("recommendation_scores")
}

// =====================================================
// CONTENU ÉDUCATIF ET RESSOURCES
// =====================================================

// Articles, vidéos, ressources sur les métiers
model Resource {
  id          Int    @id @default(autoincrement())
  title       String
  description String @db.Text
  content     String @db.Text // HTML ou Markdown
  contentType String // 'ARTICLE', 'VIDEO', 'PDF', 'LINK'

  // Médias
  thumbnailUrl String?
  mediaUrl     String? // URL de la vidéo/PDF

  // Classification
  category String? // 'METIER', 'FORMATION', 'ORIENTATION', 'CONSEIL'
  tags     String[]

  // Métadonnées
  author      String?
  viewCount   Int       @default(0)
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  relatedCareers CareerResource[]
  translations   ResourceTranslation[]

  @@index([category])
  @@index([isPublished])
  @@index([publishedAt])
  @@map("resources")
}

// Traductions des ressources
model ResourceTranslation {
  id         Int      @id @default(autoincrement())
  resourceId Int
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  languageId Int
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  title       String
  description String  @db.Text
  content     String  @db.Text
  audioUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resourceId, languageId])
  @@index([languageId])
  @@map("resource_translations")
}

// =====================================================
// FORMATIONS ET ÉTABLISSEMENTS
// =====================================================

// Établissements de formation au Bénin
model TrainingInstitution {
  id          Int     @id @default(autoincrement())
  name        String
  acronym     String? // EMN, ENEAM, IFRI, etc.
  description String? @db.Text

  type String? // 'UNIVERSITE', 'ECOLE', 'CENTRE', 'LYCEE_TECHNIQUE'

  // Localisation
  department String? // Département du Bénin
  city       String?
  address    String?

  // Contact
  phone   String?
  email   String?
  website String?

  // Offre de formation
  programs Json? // Liste des formations proposées

  // Métadonnées
  logoUrl  String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  careers      CareerInstitution[]
  translations TrainingInstitutionTranslation[]

  @@index([department])
  @@index([city])
  @@index([type])
  @@map("training_institutions")
}

// Traductions des établissements de formation
model TrainingInstitutionTranslation {
  id            Int                 @id @default(autoincrement())
  institutionId Int
  institution   TrainingInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  languageId    Int
  language      Language            @relation(fields: [languageId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, languageId])
  @@index([languageId])
  @@map("training_institution_translations")
}

// =====================================================
// CONTACT ET SUPPORT
// =====================================================

// Demandes de contact / rendez-vous
model ContactRequest {
  id     Int     @id @default(autoincrement())
  userId String? // Null si non connecté
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  name  String
  email String
  phone String?

  requestType RequestType // 'INFO', 'RENDEZ_VOUS', 'QUESTION', 'AUTRE'
  message     String      @db.Text

  // Pour rendez-vous
  preferredDate DateTime?
  preferredTime PreferredTime? // 'MATIN', 'APRES_MIDI', 'SOIR'

  // Statut
  status     ContactSatus @default(PENDING) // 'PENDING', 'CONTACTED', 'RESOLVED'
  assignedTo String? // Admin/Conseiller assigné
  response   String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("contact_requests")
}

// =====================================================
// ADMIN AUDIT LOG
// =====================================================

model AdminAuditLog {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  action   String
  entity   String
  entityId String?
  data     Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// =====================================================
// NEWS ET ANNONCES
// =====================================================

// Annonces et actualités
model Announcement {
  id      Int     @id @default(autoincrement())
  title   String
  content String  @db.Text
  excerpt String? // Résumé court

  type     AnnouncementType // 'INFO', 'EVENT', 'ALERTE', 'PROMO'
  priority Int              @default(0) // 0 = normal, 1 = important, 2 = urgent

  // Image
  imageUrl String?
  linkUrl  String? // Lien vers plus d'infos

  // Public cible
  targetAudience TargetAudience? // 'ALL', 'STUDENTS', 'PARENTS', 'TEACHERS'

  // Dates
  startDate DateTime? // Date de début d'affichage
  endDate   DateTime? // Date de fin d'affichage
  isActive  Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  // Relations
  translations AnnouncementTranslation[]

  @@index([type])
  @@index([isActive])
  @@index([startDate, endDate])
  @@index([priority])
  @@map("announcements")
}

// Traductions des annonces
model AnnouncementTranslation {
  id             Int          @id @default(autoincrement())
  announcementId Int
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  languageId     Int
  language       Language     @relation(fields: [languageId], references: [id], onDelete: Cascade)

  title    String
  content  String  @db.Text
  excerpt  String?
  audioUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([announcementId, languageId])
  @@index([languageId])
  @@map("announcement_translations")
}

