generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// ENUMS
// =====================================================

enum RiasecType {
  R // Réaliste
  I // Investigateur
  A // Artistique
  S // Social
  E // Entreprenant
  C // Conventionnel
}

enum AssessmentType {
  PHASE1
  PHASE2_OCCUPATIONS
  PHASE2_APTITUDES
  PHASE2_PERSONALITY
  FULL
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum PhaseType {
  PHASE_1
  PHASE_2
}

enum Phase2Type {
  OCCUPATIONS
  APTITUDES
  PERSONALITY
}

enum BadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum ProfileStrength {
  TRES_FAIBLE
  FAIBLE
  MOYEN
  FORT
  TRES_FORT
  EXCEPTIONNEL
}

enum ConsistencyLevel {
  FAIBLE // 1
  MOYENNE // 2
  FORTE // 3
}

enum Label {
  Faible
  Moyen
  Fort
}

enum CareerCategory {
  NUMERIQUE
  AGRICULTURE
  ARTISANAT
  SANTE
  EDUCATION
  COMMERCE
  ADMINISTRATION
}

enum FeedbackType {
  LIKE
  DISLIKE
  CLICK
  VIEW
  SKIP
}

enum InteractionEventType {
  ANSWER
  CLICK
  VIEW
  SKIP
}

enum InteractionEntityType {
  QUESTION
  CAREER
  RECOMMENDATION
}

enum OutcomeStatus {
  STUDENT
  INTERNSHIP
  EMPLOYED
  DROPOUT
}

// =====================================================
// UTILISATEURS
// =====================================================

model User {
  id          String  @id @default(cuid())
  email       String? @unique
  displayName String?
  profile     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]

  @@index([email])
  @@map("users")
}

// =====================================================
// VERSIONING & LOCALISATION
// =====================================================

model TestVersion {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  description String? @db.Text
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phase1Questions Phase1Question[]
  phase2Questions Phase2Question[]
  assessments     Assessment[]

  @@index([isActive])
  @@map("test_versions")
}

model Language {
  id         Int     @id @default(autoincrement())
  code       String  @unique
  name       String
  nativeName String?
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phase1QuestionTranslations Phase1QuestionTranslation[]
  phase2QuestionTranslations Phase2QuestionTranslation[]
  careerTranslations         CareerTranslation[]
  resourceTranslations       ResourceTranslation[]
  institutionTranslations    TrainingInstitutionTranslation[]

  @@index([isActive])
  @@map("languages")
}

// =====================================================
// SESSIONS (CONTAINER UTILISATEUR)
// =====================================================

model Session {
  id Int @id @default(autoincrement())

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  profile Json?

  sessionToken String  @unique
  shareToken   String? @unique // Pour partage public

  startedAt      DateTime @default(now())
  lastActivityAt DateTime @updatedAt

  // Gamification (niveau global de l'utilisateur)
  totalXp Int @default(0)
  level   Int @default(1)

  assessments Assessment[]
  badges      SessionBadge[]
  xpHistory   XPHistory[]

  @@index([sessionToken])
  @@index([shareToken])
  @@index([userId])
  @@map("sessions")
}

// =====================================================
// INSTANCE D'UN TEST (ASSESSMENT)
// =====================================================

model Assessment {
  id String @id @default(uuid())

  sessionId Int
  session   Session @relation(fields: [sessionId], references: [id])

  testVersionId Int
  testVersion   TestVersion @relation(fields: [testVersionId], references: [id], onDelete: Restrict)

  type   AssessmentType
  depth  Int // Nombre de questions par axe RIASEC (ex: 10 = profond, 5 = moyen, 3 = léger)
  status AssessmentStatus @default(IN_PROGRESS)

  // Progression (pour les tests FULL ou multi-phases)
  currentPhase     PhaseType @default(PHASE_1) // PHASE_1, PHASE_2
  currentSection   Phase2Type? // OCCUPATIONS, APTITUDES, PERSONALITY (phase2 uniquement)
  currentStepIndex Int         @default(0)

  // État adaptatif (stocke l'estimation du profil RIASEC en temps réel)
  adaptiveState Json? // { "probabilities": { "R": 0.3, "I": 0.2, ... }, "askedQuestions": [...] }

  startedAt      DateTime  @default(now())
  lastActivityAt DateTime  @updatedAt
  completedAt    DateTime?

  // Métriques
  completionPercentage Int @default(0)

  // Relations
  phase1Responses Phase1Response[]
  phase2Responses Phase2Response[]
  result          AssessmentResult?
  treasureMap     TreasureMap?
  feedbacks       AssessmentFeedback[]
  outcomes        AssessmentOutcome[]
  interactions    AssessmentInteraction[]
  xpHistory       XPHistory[]

  @@index([sessionId])
  @@index([testVersionId])
  @@index([type])
  @@index([status])
  @@index([startedAt])
  @@map("assessments")
}

// =====================================================
// QUESTIONS ET RÉPONSES
// =====================================================

model RiasecTypeModel {
  id           RiasecType @id
  name         String
  slogan       String?
  description  String?
  colorHex     String?
  iconUrl      String?
  displayOrder Int        @default(0)

  phase1Questions Phase1Question[]
  phase2Questions Phase2Question[]

  @@map("riasec_types")
}

model Phase1Question {
  id            Int             @id @default(autoincrement())
  riasecTypeId  RiasecType
  riasecType    RiasecTypeModel @relation(fields: [riasecTypeId], references: [id])
  testVersionId Int
  testVersion   TestVersion     @relation(fields: [testVersionId], references: [id], onDelete: Cascade)

  questionText    String  @db.Text
  questionShort   String?
  illustrationUrl String?
  displayOrder    Int     @default(0)
  isActive        Boolean @default(true)

  pointsValue Int @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses    Phase1Response[]
  translations Phase1QuestionTranslation[]

  @@unique([testVersionId, displayOrder])
  @@index([riasecTypeId])
  @@index([testVersionId])
  @@map("phase1_questions")
}

model Phase2Question {
  id            Int             @id @default(autoincrement())
  riasecTypeId  RiasecType
  riasecType    RiasecTypeModel @relation(fields: [riasecTypeId], references: [id])
  testVersionId Int
  testVersion   TestVersion     @relation(fields: [testVersionId], references: [id], onDelete: Cascade)

  phase2Type      Phase2Type
  questionText    String     @db.Text
  questionSubtext String?
  mediaUrl        String?
  displayOrder    Int        @default(0)
  isActive        Boolean    @default(true)

  minValue    Int?  @default(1)
  maxValue    Int?  @default(3)
  valueLabels Json? // { "1": "Faible 😕", "2": "Moyen 😐", "3": "Fort 😊" }

  pointsValue Int @default(15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses    Phase2Response[]
  translations Phase2QuestionTranslation[]

  @@unique([testVersionId, phase2Type, displayOrder])
  @@index([riasecTypeId])
  @@index([testVersionId])
  @@index([phase2Type])
  @@map("phase2_questions")
}

model Phase1QuestionTranslation {
  id         Int            @id @default(autoincrement())
  questionId Int
  question   Phase1Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  languageId Int
  language   Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)

  questionText  String  @db.Text
  questionShort String?
  audioUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([questionId, languageId])
  @@index([languageId])
  @@map("phase1_question_translations")
}

model Phase2QuestionTranslation {
  id         Int            @id @default(autoincrement())
  questionId Int
  question   Phase2Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  languageId Int
  language   Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)

  questionText    String  @db.Text
  questionSubtext String?
  audioUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([questionId, languageId])
  @@index([languageId])
  @@map("phase2_question_translations")
}

model AptitudeResponseOption {
  id        Int     @id @default(autoincrement())
  value     Int     @unique
  label     Label
  emoji     String?
  colorCode String?

  @@map("aptitude_response_options")
}

model Phase1Response {
  id           String         @id @default(uuid())
  assessmentId String
  assessment   Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId   Int
  question     Phase1Question @relation(fields: [questionId], references: [id])

  responseValue  Int // 0 = non, 1 = oui
  responseTimeMs Int?

  createdAt DateTime @default(now())

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
  @@index([questionId])
  @@map("phase1_responses")
}

model Phase2Response {
  id           String         @id @default(uuid())
  assessmentId String
  assessment   Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId   Int
  question     Phase2Question @relation(fields: [questionId], references: [id])
  phase2Type   Phase2Type

  responseValue  Int // 0/1 pour occupations/personnalité, 1-3 pour aptitudes
  responseTimeMs Int?

  createdAt DateTime @default(now())

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
  @@index([questionId])
  @@map("phase2_responses")
}

// =====================================================
// RÉSULTATS D'UN ASSESSMENT
// =====================================================

model AssessmentResult {
  id           String     @id @default(uuid())
  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // Codes
  phase1Code        String? @db.Char(3) // Ex: "RIA" (si phase1 incluse)
  phase2Code        String? @db.Char(3) // Ex: "RIS" (si phase2 incluse)
  subjectiveRanking Json? // Classement subjectif (cartes EPCR)

  // Scores bruts
  phase1Scores  Json? // { "R": 5, "I": 3, ... }
  phase2Scores  Json? // { "R": 15, "I": 22, ... }
  sectionScores Json? // Détails par section (occupations, aptitudes, personnalité)

  // Indicateurs de qualité
  consistencyScore     Float?
  consistencyLevel     ConsistencyLevel?
  differentiationScore Float?
  profileStrength      ProfileStrength?

  // Interprétations (générées par l'IA)
  insights   Json? // Liste d'insights personnalisés
  strengths  String[] // Forces identifiées
  weaknesses String[] // Faiblesses identifiées (pour conseils)

  createdAt    DateTime  @default(now())
  lastViewedAt DateTime?
  viewCount    Int       @default(0)

  // Relations
  careerRecommendations AssessmentCareerRecommendation[]

  @@index([assessmentId])
  @@index([phase2Code])
  @@index([consistencyLevel])
  @@map("assessment_results")
}

// =====================================================
// MÉTIERS ET RECOMMANDATIONS
// =====================================================

model Career {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String  @db.Text
  summary     String?

  riasecCodes RiasecType[] // Codes RIASEC associés

  localDemand    Int? // 1-5 (demande au Bénin)
  formationLevel String? // 'CAP', 'BAC', 'BTS', etc.
  salaryRangeMin Int?
  salaryRangeMax Int?
  careerPath     String?

  iconUrl  String?
  imageUrl String?
  videoUrl String?

  category CareerCategory?
  tags     String[]

  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)
  viewCount  Int     @default(0)
  clickCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recommendations AssessmentCareerRecommendation[]
  institutions    CareerInstitution[]
  resources       CareerResource[]
  translations    CareerTranslation[]
  outcomes        AssessmentOutcome[]

  @@index([category])
  @@index([isFeatured])
  @@map("careers")
}

model CareerInstitution {
  careerId      Int
  career        Career              @relation(fields: [careerId], references: [id], onDelete: Cascade)
  institutionId Int
  institution   TrainingInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  isPrimary     Boolean             @default(false)

  createdAt DateTime @default(now())

  @@id([careerId, institutionId])
  @@index([institutionId])
  @@map("career_institutions")
}

model CareerResource {
  careerId   Int
  career     Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  resourceId Int
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([careerId, resourceId])
  @@index([resourceId])
  @@map("career_resources")
}

model CareerTranslation {
  id         Int      @id @default(autoincrement())
  careerId   Int
  career     Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  languageId Int
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  name        String
  summary     String?
  description String  @db.Text
  audioUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([careerId, languageId])
  @@index([languageId])
  @@map("career_translations")
}

model AssessmentCareerRecommendation {
  id       String           @id @default(uuid())
  resultId String
  result   AssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  careerId Int
  career   Career           @relation(fields: [careerId], references: [id], onDelete: Cascade)

  matchScore   Int // 0-100
  rankPosition Int

  viewedAt      DateTime?
  savedForLater Boolean   @default(false)

  createdAt DateTime @default(now())

  feedbacks AssessmentFeedback[]

  @@unique([resultId, careerId])
  @@index([resultId])
  @@index([careerId])
  @@index([matchScore])
  @@map("assessment_career_recommendations")
}

// =====================================================
// GAMIFICATION (AU NIVEAU SESSION)
// =====================================================

model Badge {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  description String  @db.Text
  iconUrl     String?
  emoji       String?

  rarity      BadgeRarity @default(COMMON)
  pointsValue Int         @default(50)

  unlockCondition Json? // { "type": "phase_completion", "phase": 1 }

  unlockCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionBadges SessionBadge[]

  @@index([rarity])
  @@map("badges")
}

model SessionBadge {
  id        String  @id @default(uuid())
  sessionId Int
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  badgeId   Int
  badge     Badge   @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  unlockedAt     DateTime @default(now())
  sharedOnSocial Boolean  @default(false)

  @@unique([sessionId, badgeId])
  @@index([sessionId])
  @@index([badgeId])
  @@map("session_badges")
}

model XPHistory {
  id        String  @id @default(uuid())
  sessionId Int
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  amount       Int
  reason       String? // "test_completed", "badge_earned", etc.
  assessmentId String? // optionnel, lien vers l'évaluation qui a rapporté ces XP
  assessment   Assessment? @relation(fields: [assessmentId], references: [id])

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
  @@map("xp_history")
}

// =====================================================
// CARTE AU TRÉSOR
// =====================================================

model TreasureMap {
  id           String     @id @default(uuid())
  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  mapData    Json
  pdfUrl     String?
  shareToken String  @unique

  viewCount     Int @default(0)
  downloadCount Int @default(0)

  createdAt    DateTime  @default(now())
  lastViewedAt DateTime?

  @@index([shareToken])
  @@map("treasure_maps")
}

// =====================================================
// FEEDBACK & OUTCOMES (AU NIVEAU ASSESSMENT)
// =====================================================

model AssessmentFeedback {
  id String @id @default(uuid())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  recommendationId String?
  recommendation   AssessmentCareerRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  type  FeedbackType
  value Float

  context Json?

  createdAt DateTime @default(now())

  @@index([assessmentId])
  @@index([recommendationId])
  @@index([type])
  @@map("assessment_feedbacks")
}

model AssessmentOutcome {
  id String @id @default(uuid())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  careerId Int
  career   Career @relation(fields: [careerId], references: [id], onDelete: Cascade)

  status         OutcomeStatus
  sector         String
  salaryRange    String?
  delayToOutcome Int

  createdAt DateTime @default(now())

  @@index([assessmentId])
  @@index([careerId])
  @@index([status])
  @@map("assessment_outcomes")
}

// =====================================================
// INTERACTIONS POUR ADAPTATION
// =====================================================

model AssessmentInteraction {
  id           BigInt                @id @default(autoincrement())
  assessmentId String
  assessment   Assessment            @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  type         InteractionEventType
  entityType   InteractionEntityType
  entityId     Int
  value        Float?
  metadata     Json?
  createdAt    DateTime              @default(now())

  @@index([assessmentId])
  @@index([type])
  @@index([entityType])
  @@index([createdAt])
  @@map("assessment_interactions")
}

// =====================================================
// CONTENU ÉDUCATIF ET FORMATIONS
// =====================================================

model Resource {
  id          Int    @id @default(autoincrement())
  title       String
  description String @db.Text
  content     String @db.Text
  contentType String // 'ARTICLE', 'VIDEO', 'PDF', 'LINK'

  thumbnailUrl String?
  mediaUrl     String?

  category String?
  tags     String[]

  author      String?
  viewCount   Int       @default(0)
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  relatedCareers CareerResource[]
  translations   ResourceTranslation[]

  @@index([category])
  @@index([isPublished])
  @@map("resources")
}

model ResourceTranslation {
  id         Int      @id @default(autoincrement())
  resourceId Int
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  languageId Int
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  title       String
  description String  @db.Text
  content     String  @db.Text
  audioUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resourceId, languageId])
  @@index([languageId])
  @@map("resource_translations")
}

model TrainingInstitution {
  id          Int     @id @default(autoincrement())
  name        String
  acronym     String?
  description String? @db.Text

  type String? // 'UNIVERSITE', 'ECOLE', 'CENTRE', 'LYCEE_TECHNIQUE'

  department String?
  city       String?
  address    String?

  phone   String?
  email   String?
  website String?

  programs Json?

  logoUrl  String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  careers      CareerInstitution[]
  translations TrainingInstitutionTranslation[]

  @@index([department])
  @@index([city])
  @@map("training_institutions")
}

model TrainingInstitutionTranslation {
  id            Int                 @id @default(autoincrement())
  institutionId Int
  institution   TrainingInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  languageId    Int
  language      Language            @relation(fields: [languageId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, languageId])
  @@index([languageId])
  @@map("training_institution_translations")
}
