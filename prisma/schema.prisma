generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  url      = env("DATABASE_URL")
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// ENUMS
// =====================================================

enum RiasecType {
  R // Réaliste
  I // Investigateur
  A // Artistique
  S // Social
  E // Entreprenant
  C // Conventionnel
}

enum AssessmentType {
  PHASE1
  PHASE2_OCCUPATIONS
  PHASE2_APTITUDES
  PHASE2_PERSONALITY
  FULL
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum PhaseType {
  PHASE1
  PHASE2
}

enum Phase2Type {
  OCCUPATIONS
  APTITUDES
  PERSONALITY
}

enum BadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum ProfileStrength {
  TRES_FAIBLE
  FAIBLE
  MOYEN
  FORT
  TRES_FORT
  EXCEPTIONNEL
}

enum ConsistencyLevel {
  FAIBLE // 1
  MOYENNE // 2
  FORTE // 3
}

enum Label {
  Faible
  Moyen
  Fort
}

enum CareerCategory {
  NUMERIQUE
  AGRICULTURE
  ARTISANAT
  SANTE
  EDUCATION
  COMMERCE
  ADMINISTRATION
}

enum FeedbackType {
  LIKE
  DISLIKE
  CLICK
  VIEW
  SKIP
}

enum InteractionEventType {
  ANSWER
  CLICK
  VIEW
  SKIP
}

enum InteractionEntityType {
  QUESTION
  CAREER
  RECOMMENDATION
}

enum OutcomeStatus {
  STUDENT
  INTERNSHIP
  EMPLOYED
  DROPOUT
}

enum UserRole {
  ADMIN
  AGENT
  USER
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
}

// =====================================================
// UTILISATEURS
// =====================================================

model User {
  id    String  @id @default(cuid())
  email String? @unique

  first_name   String? @db.VarChar(100)
  last_name    String? @db.VarChar(100)
  display_name String? @db.VarChar(150)
  bio          String? @db.Text

  password   String?
  is_deleted Boolean    @default(false)
  role       UserRole   @default(USER)
  status     UserStatus @default(ACTIVE)

  email_verified_at DateTime?
  last_login_at     DateTime?
  role_assigned_at  DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  auth_accounts AuthAccount[]
  auth_sessions Session[]
  auth_token    AuthToken?
  tokens        Token[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model AuthAccount {
  id                    String       @id @default(uuid())
  user_id               String
  provider              AuthProvider
  provider_account_id   String       @db.VarChar(255)
  provider_email        String       @db.VarChar(255)
  access_token          String?      @db.Text
  refresh_token         String?      @db.Text
  access_token_expires  DateTime?
  refresh_token_expires DateTime?
  scope                 String?      @db.VarChar(500)
  id_token              String?      @db.Text
  session_state         String?      @db.VarChar(500)

  provider_metadata Json?

  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  last_used_at DateTime?

  user User @relation(fields: [user_id], references: [id])

  @@unique([provider, provider_account_id])
  @@unique([user_id, provider])
  @@index([user_id])
  @@index([provider])
  @@map("auth_accounts")
}

model AuthToken {
  id             String    @id @default(uuid())
  user_id        String    @unique
  token_hash     String
  token_type     String
  expires_at     DateTime
  used_at        DateTime?
  invalidated_at DateTime?

  ip_address String? @db.VarChar(45)
  user_agent String? @db.Text
  metadata   Json?

  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([expires_at])
  @@index([token_hash])
  @@index([token_hash, token_type])
  @@map("refresh_tokens")
}


model Token {
  id         Int      @id @default(autoincrement())
  user_id    String
  token_hash String
  token_type String
  expires_at DateTime

  metadata Json?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  deleted_at DateTime?

  @@index([token_hash])
  @@index([expires_at])
  @@index([token_hash, token_type])
  @@map("tokens")
}

// =====================================================
// VERSIONING & LOCALISATION
// =====================================================

model TestVersion {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  description String? @db.Text
  is_active   Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  phase1_questions Phase1Question[]
  phase2_questions Phase2Question[]
  assessments      Assessment[]

  @@index([is_active])
  @@map("test_versions")
}

model Language {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  native_name String?
  is_active   Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  phase1_question_translations Phase1QuestionTranslation[]
  phase2_question_translations Phase2QuestionTranslation[]
  career_translations          CareerTranslation[]
  resource_translations        ResourceTranslation[]
  institution_translations     TrainingInstitutionTranslation[]

  @@index([is_active])
  @@map("languages")
}

// =====================================================
// SESSIONS (CONTAINER UTILISATEUR)
// =====================================================

model Session {
  id String @id @default(uuid())

  user_id String?

  session_token String  @unique
  session_hash  String
  share_token   String? @unique // Pour partage public

  is_active  Boolean  @default(true)
  is_current Boolean  @default(false)
  expires_at DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Gamification (niveau global de l'utilisateur)
  total_xp Int @default(0)
  level    Int @default(1)

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  assessments Assessment[]
  badges      SessionBadge[]
  xpHistory   XPHistory[]

  @@index([session_token])
  @@index([share_token])
  @@index([user_id])
  @@map("auth_sessions")
}

// =====================================================
// INSTANCE D'UN TEST (ASSESSMENT)
// =====================================================

model Assessment {
  id String @id @default(uuid())

  session_id String
  session    Session @relation(fields: [session_id], references: [id])

  test_version_id Int
  test_version    TestVersion @relation(fields: [test_version_id], references: [id], onDelete: Restrict)

  type   AssessmentType
  depth  Int // Nombre de questions par axe RIASEC (ex: 10 = profond, 5 = moyen, 3 = léger)
  status AssessmentStatus @default(IN_PROGRESS)

  // Progression (pour les tests FULL ou multi-phases)
  current_phase     PhaseType   @default(PHASE1) // PHASE1, PHASE2
  current_section   Phase2Type? // OCCUPATIONS, APTITUDES, PERSONALITY (phase2 uniquement)
  current_stepIndex Int         @default(0)

  // Système adaptatif par lots
  batch_size    Int @default(5) // Taille d'un lot de questions
  current_batch Int @default(0) // Index du lot en cours

  // État adaptatif (stocke l'estimation du profil RIASEC en temps réel)
  adaptive_state Json? // { "probabilities": { "R": 0.3, "I": 0.2, ... }, "askedQuestions": [...] }

  started_at      DateTime  @default(now())
  lastActivity_at DateTime  @updatedAt
  completed_at    DateTime?

  // Métriques
  completion_percentage Int @default(0)

  // Relations
  phase1_responses      Phase1Response[]
  phase2_responses      Phase2Response[]
  result                AssessmentResult?
  treasure_map          TreasureMap?
  feedbacks             AssessmentFeedback[]
  outcomes              AssessmentOutcome[]
  interactions          AssessmentInteraction[]
  xp_history            XPHistory[]
  batches               BatchHistory[]
  behavioral_indicators BehavioralIndicator[]
  intermediate_profiles IntermediateProfile[]

  @@index([session_id])
  @@index([test_version_id])
  @@index([type])
  @@index([status])
  @@index([started_at])
  @@map("assessments")
}

// =====================================================
// QUESTIONS ET RÉPONSES
// =====================================================

model RiasecTypeModel {
  id            RiasecType @id
  name          String
  slogan        String?
  description   String?
  color_hex     String?
  icon_url      String?
  display_order Int        @default(0)

  phase1_questions Phase1Question[]
  phase2_questions Phase2Question[]

  @@map("riasec_types")
}

model Phase1Question {
  id              Int             @id @default(autoincrement())
  riasec_type_id  RiasecType
  riasec_type     RiasecTypeModel @relation(fields: [riasec_type_id], references: [id])
  test_version_id Int
  test_version    TestVersion     @relation(fields: [test_version_id], references: [id], onDelete: Cascade)

  question_text    String  @db.Text
  question_short   String?
  illustration_url String?
  display_order    Int     @default(0)
  is_active        Boolean @default(true)

  pointsValue Int @default(10)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  responses    Phase1Response[]
  translations Phase1QuestionTranslation[]
  profiles     QuestionProfile[]           @relation("Phase1QuestionProfiles")

  @@unique([test_version_id, display_order])
  @@index([riasec_type_id])
  @@index([test_version_id])
  @@map("phase1_questions")
}

model Phase2Question {
  id              Int             @id @default(autoincrement())
  riasec_type_id  RiasecType
  riasec_type     RiasecTypeModel @relation(fields: [riasec_type_id], references: [id])
  test_version_id Int
  test_version    TestVersion     @relation(fields: [test_version_id], references: [id], onDelete: Cascade)

  phase2_type      Phase2Type
  question_text    String     @db.Text
  question_subtext String?
  media_url        String?
  display_order    Int        @default(0)
  is_active        Boolean    @default(true)

  min_value    Int?  @default(1)
  max_value    Int?  @default(3)
  value_labels Json? // { "1": "Faible 😕", "2": "Moyen 😐", "3": "Fort 😊" }

  points_value Int @default(15)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  responses    Phase2Response[]
  translations Phase2QuestionTranslation[]
  profiles     QuestionProfile[]           @relation("Phase2QuestionProfiles")

  @@unique([test_version_id, phase2_type, display_order])
  @@index([riasec_type_id])
  @@index([test_version_id])
  @@index([phase2_type])
  @@map("phase2_questions")
}

model Phase1QuestionTranslation {
  id          Int            @id @default(autoincrement())
  question_id Int
  question    Phase1Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
  language_id Int
  language    Language       @relation(fields: [language_id], references: [id], onDelete: Cascade)

  question_text  String  @db.Text
  question_short String?
  audio_url      String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([question_id, language_id])
  @@index([language_id])
  @@map("phase1_question_translations")
}

model Phase2QuestionTranslation {
  id          Int            @id @default(autoincrement())
  question_id Int
  question    Phase2Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
  language_id Int
  language    Language       @relation(fields: [language_id], references: [id], onDelete: Cascade)

  question_text    String  @db.Text
  question_subtext String?
  audio_url        String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([question_id, language_id])
  @@index([language_id])
  @@map("phase2_question_translations")
}

model AptitudeResponseOption {
  id         Int     @id @default(autoincrement())
  value      Int     @unique
  label      Label
  emoji      String?
  color_code String?

  @@map("aptitude_response_options")
}

model Phase1Response {
  id            String         @id @default(uuid())
  assessment_id String
  assessment    Assessment     @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  question_id   Int
  question      Phase1Question @relation(fields: [question_id], references: [id])

  response_value   Int // 0 = non, 1 = oui
  response_time_ms Int?

  // Tracking comportemental
  time_taken_ms Int? // Temps total pris pour répondre
  change_count  Int   @default(0) // Nombre de fois que la réponse a été modifiée
  metadata      Json? // Métadonnées supplémentaires (ex: timestamps des changements)

  created_at DateTime @default(now())

  @@unique([assessment_id, question_id])
  @@index([assessment_id])
  @@index([question_id])
  @@map("phase1_responses")
}

model Phase2Response {
  id            String         @id @default(uuid())
  assessment_id String
  assessment    Assessment     @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  question_id   Int
  question      Phase2Question @relation(fields: [question_id], references: [id])
  phase2_type   Phase2Type

  response_value   Int // 0/1 pour occupations/personnalité, 1-3 pour aptitudes
  response_time_ms Int?

  // Tracking comportemental
  time_taken_ms Int? // Temps total pris pour répondre
  change_count  Int   @default(0) // Nombre de fois que la réponse a été modifiée
  metadata      Json? // Métadonnées supplémentaires (ex: timestamps des changements)

  created_at DateTime @default(now())

  @@unique([assessment_id, question_id])
  @@index([assessment_id])
  @@index([question_id])
  @@map("phase2_responses")
}

// =====================================================
// SYSTÈME ADAPTATIF - PROFILS MULTI-QUESTIONS
// =====================================================

model QuestionProfile {
  id                  Int        @id @default(autoincrement())
  phase               PhaseType

  phase1_question_id  Int?
  phase2_question_id  Int?

  riasec_type         RiasecType
  weight              Float

  phase1_question     Phase1Question? @relation("Phase1QuestionProfiles", fields: [phase1_question_id], references: [id], onDelete: Cascade)
  phase2_question     Phase2Question? @relation("Phase2QuestionProfiles", fields: [phase2_question_id], references: [id], onDelete: Cascade)

  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt

  // Contrainte d'intégrité : une seule des deux colonnes doit être remplie selon la phase
  @@unique([phase1_question_id, phase, riasec_type])
  @@unique([phase2_question_id, phase, riasec_type])
  @@index([phase1_question_id])
  @@index([phase2_question_id])
  @@index([phase])
  @@index([riasec_type])
  @@map("question_profiles")
}

// =====================================================
// SYSTÈME ADAPTATIF - GESTION DES LOTS
// =====================================================

model BatchHistory {
  id            String     @id @default(uuid())
  assessment_id String
  assessment    Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  batch_index  Int // Index du lot (0, 1, 2, ...)
  phase_type   PhaseType
  question_ids Int[] // IDs des questions présentées dans ce lot

  presented_at DateTime  @default(now())
  completed_at DateTime?

  @@unique([assessment_id, batch_index])
  @@index([assessment_id])
  @@index([batch_index])
  @@map("batch_history")
}

// =====================================================
// ANALYSE COMPORTEMENTALE
// =====================================================

model BehavioralIndicator {
  id            String     @id @default(uuid())
  assessment_id String
  assessment    Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  response_id    String // Phase1Response ou Phase2Response ID
  indicator_type String // 'hesitation', 'doubt', 'change', 'excitement', 'consistent'

  time_taken_ms Int? // Temps pris pour répondre (si applicable)
  change_count  Int   @default(0) // Nombre de changements de réponse
  metadata      Json? // Données supplémentaires contextuelles

  detected_at DateTime @default(now())

  @@index([assessment_id])
  @@index([indicator_type])
  @@index([detected_at])
  @@map("behavioral_indicators")
}

// =====================================================
// PROFILS INTERMÉDIAIRES (APRÈS CHAQUE LOT)
// =====================================================

model IntermediateProfile {
  id            String     @id @default(uuid())
  assessment_id String
  assessment    Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  batch_index Int // Index du lot après lequel ce profil a été calculé
  phase_type  PhaseType

  profile_data Json // { "R": 0.3, "I": 0.2, "A": 0.15, "S": 0.1, "E": 0.15, "C": 0.1 }
  raw_scores   Json? // Scores bruts avant normalisation

  calculated_at DateTime @default(now())

  @@unique([assessment_id, batch_index])
  @@index([assessment_id])
  @@index([batch_index])
  @@map("intermediate_profiles")
}

// =====================================================
// RÉSULTATS D'UN ASSESSMENT
// =====================================================

model AssessmentResult {
  id            String     @id @default(uuid())
  assessment_id String     @unique
  assessment    Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  // Codes
  phase1_code        String? @db.Char(3) // Ex: "RIA" (si phase1 incluse)
  phase2_code        String? @db.Char(3) // Ex: "RIS" (si phase2 incluse)
  subjective_ranking Json? // Classement subjectif (cartes EPCR)

  // Scores bruts
  phase1_scores  Json? // { "R": 5, "I": 3, ... }
  phase2_scores  Json? // { "R": 15, "I": 22, ... }
  section_scores Json? // Détails par section (occupations, aptitudes, personnalité)

  // Indicateurs de qualité
  consistency_score     Float?
  consistency_level     ConsistencyLevel?
  differentiation_score Float?
  profile_strength      ProfileStrength?

  // Interprétations (générées par l'IA)
  insights   Json? // Liste d'insights personnalisés
  strengths  String[] // Forces identifiées
  weaknesses String[] // Faiblesses identifiées (pour conseils)

  created_at    DateTime  @default(now())
  lastViewed_at DateTime?
  view_sount    Int       @default(0)

  // Relations
  career_recommendations AssessmentCareerRecommendation[]

  @@index([assessment_id])
  @@index([phase2_code])
  @@index([consistency_level])
  @@map("assessment_results")
}

// =====================================================
// MÉTIERS ET RECOMMANDATIONS
// =====================================================

model Career {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String  @db.Text
  summary     String?

  riasec_codes RiasecType[] // Codes RIASEC associés

  local_demand     Int? // 1-5 (demande au Bénin)
  formation_level  String? // 'CAP', 'BAC', 'BTS', etc.
  salary_range_min Int?
  salary_range_max Int?
  career_path      String?

  icon_url  String?
  image_url String?
  video_url String?

  category CareerCategory?
  tags     String[]

  is_featured Boolean @default(false)
  is_active   Boolean @default(true)
  view_count  Int     @default(0)
  click_count Int     @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  recommendations AssessmentCareerRecommendation[]
  institutions    CareerInstitution[]
  resources       CareerResource[]
  translations    CareerTranslation[]
  outcomes        AssessmentOutcome[]
  trainingPaths   TrainingPath[]

  @@index([category])
  @@index([is_featured])
  @@map("careers")
}

model CareerInstitution {
  career_id      Int
  career         Career              @relation(fields: [career_id], references: [id], onDelete: Cascade)
  institution_id Int
  institution    TrainingInstitution @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  is_primary     Boolean             @default(false)

  created_at DateTime @default(now())

  @@id([career_id, institution_id])
  @@index([institution_id])
  @@map("career_institutions")
}

model CareerResource {
  career_id   Int
  career      Career   @relation(fields: [career_id], references: [id], onDelete: Cascade)
  resource_id Int
  resource    Resource @relation(fields: [resource_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@id([career_id, resource_id])
  @@index([resource_id])
  @@map("career_resources")
}

model CareerTranslation {
  id          Int      @id @default(autoincrement())
  career_id   Int
  career      Career   @relation(fields: [career_id], references: [id], onDelete: Cascade)
  language_id Int
  language    Language @relation(fields: [language_id], references: [id], onDelete: Cascade)

  name        String
  summary     String?
  description String  @db.Text
  audioUrl    String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([career_id, language_id])
  @@index([language_id])
  @@map("career_translations")
}

model AssessmentCareerRecommendation {
  id          String           @id @default(uuid())
  result_id String
  result      AssessmentResult @relation(fields: [result_id], references: [id], onDelete: Cascade)
  career_id   Int
  career      Career           @relation(fields: [career_id], references: [id], onDelete: Cascade)

  match_score   Int // 0-100
  rank_position Int

  viewed_at      DateTime?
  saved_forLater Boolean   @default(false)

  created_at DateTime @default(now())

  feedbacks AssessmentFeedback[]

  @@unique([result_id, career_id])
  @@index([result_id])
  @@index([career_id])
  @@index([match_score])
  @@map("assessment_career_recommendations")
}

// =====================================================
// GAMIFICATION (AU NIVEAU SESSION)
// =====================================================

model Badge {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  description String  @db.Text
  icon_url    String?
  emoji       String?

  rarity       BadgeRarity @default(COMMON)
  points_value Int         @default(50)

  unlock_condition Json? // { "type": "phase_completion", "phase": 1 }

  unlock_count Int @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  session_badges SessionBadge[]

  @@index([rarity])
  @@map("badges")
}

model SessionBadge {
  id         String  @id @default(uuid())
  session_id String
  session    Session @relation(fields: [session_id], references: [id], onDelete: Cascade)
  badge_id   Int
  badge      Badge   @relation(fields: [badge_id], references: [id], onDelete: Cascade)

  unlocked_at      DateTime @default(now())
  shared_on_social Boolean  @default(false)

  @@unique([session_id, badge_id])
  @@index([session_id])
  @@index([badge_id])
  @@map("session_badges")
}

model XPHistory {
  id         String  @id @default(uuid())
  session_id String
  session    Session @relation(fields: [session_id], references: [id], onDelete: Cascade)

  amount        Int
  reason        String? // "test_completed", "badge_earned", etc.
  assessment_id String? // optionnel, lien vers l'évaluation qui a rapporté ces XP
  assessment    Assessment? @relation(fields: [assessment_id], references: [id])

  created_at DateTime @default(now())

  @@index([session_id])
  @@index([created_at])
  @@map("xp_history")
}

// =====================================================
// CARTE AU TRÉSOR
// =====================================================

model TreasureMap {
  id            String     @id @default(uuid())
  assessment_id String     @unique
  assessment    Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  map_data    Json
  pdf_url     String?
  share_token String  @unique

  view_count     Int @default(0)
  download_count Int @default(0)

  created_at     DateTime  @default(now())
  last_viewed_at DateTime?

  @@index([share_token])
  @@map("treasure_maps")
}

// =====================================================
// FEEDBACK & OUTCOMES (AU NIVEAU ASSESSMENT)
// =====================================================

model AssessmentFeedback {
  id String @id @default(uuid())

  assessment_id String
  assessment    Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  recommendationId String?
  recommendation   AssessmentCareerRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  type  FeedbackType
  value Float

  context Json?

  created_at DateTime @default(now())

  @@index([assessment_id])
  @@index([recommendationId])
  @@index([type])
  @@map("assessment_feedbacks")
}

model AssessmentOutcome {
  id String @id @default(uuid())

  assessment_id String
  assessment    Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  career_id Int
  career    Career @relation(fields: [career_id], references: [id], onDelete: Cascade)

  status           OutcomeStatus
  sector           String
  salary_range     String?
  delay_to_outcome Int

  created_at DateTime @default(now())

  @@index([assessment_id])
  @@index([career_id])
  @@index([status])
  @@map("assessment_outcomes")
}

// =====================================================
// INTERACTIONS POUR ADAPTATION
// =====================================================

model AssessmentInteraction {
  id            BigInt                @id @default(autoincrement())
  assessment_id String
  assessment    Assessment            @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  type          InteractionEventType
  entity_type   InteractionEntityType
  entity_id     Int
  value         Float?
  metadata      Json?
  created_at    DateTime              @default(now())

  @@index([assessment_id])
  @@index([type])
  @@index([entity_type])
  @@index([created_at])
  @@map("assessment_interactions")
}

// =====================================================
// CONTENU ÉDUCATIF ET FORMATIONS
// =====================================================

model Resource {
  id           Int    @id @default(autoincrement())
  title        String
  description  String @db.Text
  content      String @db.Text
  content_type String // 'ARTICLE', 'VIDEO', 'PDF', 'LINK'

  thumbnail_url String?
  media_url     String?

  category String?
  tags     String[]

  author       String?
  view_count   Int       @default(0)
  is_published Boolean   @default(false)
  published_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  related_careers CareerResource[]
  translations    ResourceTranslation[]

  @@index([category])
  @@index([is_published])
  @@map("resources")
}

model ResourceTranslation {
  id          Int      @id @default(autoincrement())
  resource_id Int
  resource    Resource @relation(fields: [resource_id], references: [id], onDelete: Cascade)
  language_id Int
  language    Language @relation(fields: [language_id], references: [id], onDelete: Cascade)

  title       String
  description String  @db.Text
  content     String  @db.Text
  audio_url   String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([resource_id, language_id])
  @@index([language_id])
  @@map("resource_translations")
}

// =====================================================
// LIENS UTILES
// =====================================================

model LinkCategory {
  id   Int    @id @default(autoincrement())
  name String @unique

  links Link[]

  @@map("link_categories")
}

model Link {
  id          Int          @id @default(autoincrement())
  category_id Int
  category    LinkCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)

  title String
  url   String?
  note  String? @db.Text

  @@unique([category_id, title])
  @@index([category_id])
  @@map("links")
}

model TrainingInstitution {
  id          Int     @id @default(autoincrement())
  name        String
  acronym     String?
  description String? @db.Text

  type String? // 'UNIVERSITE', 'ECOLE', 'CENTRE', 'LYCEE_TECHNIQUE'

  department String?
  city       String?
  address    String?
  latitude   Float?
  longitude  Float?

  phone   String?
  email   String?
  website String?

  programs Json?

  logo_url  String?
  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  careers       CareerInstitution[]
  translations  TrainingInstitutionTranslation[]
  trainingPaths TrainingPath[]

  @@index([department])
  @@index([city])
  @@map("training_institutions")
}

model TrainingPath {
  id              Int     @id @default(autoincrement())
  name            String
  description     String? @db.Text
  level           String?
  duration_months Int?
  cost_min        Int?
  cost_max        Int?

  career_id      Int?
  career         Career?              @relation(fields: [career_id], references: [id], onDelete: SetNull)
  institution_id Int?
  institution    TrainingInstitution? @relation(fields: [institution_id], references: [id], onDelete: SetNull)

  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([career_id])
  @@index([institution_id])
  @@index([is_active])
  @@map("training_paths")
}

model TrainingInstitutionTranslation {
  id             Int                 @id @default(autoincrement())
  institution_id Int
  institution    TrainingInstitution @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  language_id    Int
  language       Language            @relation(fields: [language_id], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([institution_id, language_id])
  @@index([language_id])
  @@map("training_institution_translations")
}
